diff --git a/ps2xRuntime/include/runtime/ps2_guest_memory.h b/ps2xRuntime/include/runtime/ps2_guest_memory.h
new file mode 100644
index 0000000..1950314
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_guest_memory.h
@@ -0,0 +1,64 @@
+#pragma once
+
+#include <cstdint>
+
+// The runtime's own memory inside the guest's 32 MiB. The console's kernel lives in 0x00080000 to
+// 0x00100000 (measured on two console memory images: 0x00080000-0x0009FFFF holds the console's
+// kernel, 0x000A0000-0x000FFFFF is all zeroes, and nothing of the game lives below 0x00100000),
+// and none of that kernel exists in this runtime. The runtime's own guest-RAM structures therefore
+// live there, outside the game's image, its heap and its stacks. Before this change they sat at
+// 0x01F00000 and above: guestMalloc handed out blocks from the base of the game's own heap (0x5A6800)
+// and the invocation stacks grew down from the top of RAM over the main thread's stack
+// (0x01F80000-0x02000000), which is why the game's heap had to be clamped to 0x01F00000 to leave room.
+//
+//   0x00080000-0x000BFFFF  invocation stacks: 16 of 0x4000, bumped downwards from 0x000C0000
+//   0x000C0000-0x000CFFFF  remote-call packet pool (wraps by design)
+//   0x000D0000-0x000DFFFF  remote-call server pool (wraps by design)
+//   0x000E0000-0x000EFFFF  thread-local-storage pool (wraps by design)
+//   0x000F0000-0x000F0FFF  boot-mode pool (does not wrap)
+//   0x000F1000-0x000FFFFF  the runtime's own allocator: guestMalloc/guestCalloc/guestRealloc/guestFree
+static constexpr uint32_t kRuntimeGuestMemoryBase = 0x00080000;
+static constexpr uint32_t kRuntimeGuestMemoryEnd = 0x00100000;
+
+static constexpr uint32_t kInvocationStackSize = 0x4000;
+static constexpr uint32_t kInvocationStackBase = 0x000C0000;
+static constexpr uint32_t kInvocationStackFloor = 0x00080000;
+static constexpr uint32_t kInvocationStackCount =
+    (kInvocationStackBase - kInvocationStackFloor) / kInvocationStackSize;
+
+static constexpr uint32_t kRpcPacketSize = 64;
+static constexpr uint32_t kRpcPacketPoolBase = 0x000C0000;
+static constexpr uint32_t kRpcPacketPoolBytes = 0x00010000;
+static constexpr uint32_t kRpcPacketPoolCount = kRpcPacketPoolBytes / kRpcPacketSize;
+static constexpr uint32_t kRpcServerPoolBase = 0x000D0000;
+static constexpr uint32_t kRpcServerPoolBytes = 0x00010000;
+static constexpr uint32_t kRpcServerStride = 0x80;
+static constexpr uint32_t kRpcServerPoolCount = kRpcServerPoolBytes / kRpcServerStride;
+
+static constexpr uint32_t kTlsPoolBase = 0x000E0000;
+static constexpr uint32_t kTlsPoolBytes = 0x00010000;
+static constexpr uint32_t kTlsBlockSize = 0x100;
+static constexpr uint32_t kTlsPoolCount = kTlsPoolBytes / kTlsBlockSize;
+
+static constexpr uint32_t kBootModePoolBase = 0x000F0000;
+static constexpr uint32_t kBootModePoolBytes = 0x00001000;
+
+static constexpr uint32_t kRuntimeAllocatorBase = 0x000F1000;
+static constexpr uint32_t kRuntimeAllocatorEnd = 0x00100000;
+static constexpr uint32_t kRuntimeAllocatorBytes = kRuntimeAllocatorEnd - kRuntimeAllocatorBase;
+
+// The table above: no region overlaps another and all of them end at or below the game's image.
+static_assert(kInvocationStackBase == kRpcPacketPoolBase,
+              "the invocation stacks are bumped downwards from the packet pool");
+static_assert(kInvocationStackFloor >= kRuntimeGuestMemoryBase,
+              "the invocation stacks start at the runtime's own area");
+static_assert(kInvocationStackCount == 16u, "the area holds 16 invocation stacks of 0x4000 bytes");
+static_assert(kRpcPacketPoolBase + kRpcPacketPoolBytes == kRpcServerPoolBase, "packets, then servers");
+static_assert(kRpcServerPoolBase + kRpcServerPoolBytes == kTlsPoolBase, "servers, then TLS");
+static_assert(kTlsPoolBase + kTlsPoolBytes == kBootModePoolBase, "TLS, then boot mode");
+static_assert(kBootModePoolBase + kBootModePoolBytes <= kRuntimeAllocatorBase,
+              "boot mode, then the runtime's allocator");
+static_assert(kRuntimeAllocatorEnd <= kRuntimeGuestMemoryEnd,
+              "the runtime's allocator ends inside the runtime's own area");
+static_assert(kRuntimeGuestMemoryEnd <= 0x00100000u,
+              "the runtime's own memory must stay below the game's image");
