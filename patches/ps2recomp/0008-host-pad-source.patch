+
+void PSPadBackend::setHostSource(const Ps2HostPad *source)
+{
+    if (source && source->read)
+    {
+        m_source = *source;
+        m_source.port_count = std::min<uint32_t>(m_source.port_count, PS2_HOST_PAD_MAX_PORTS);
+        for (uint32_t port = 0; port < PS2_HOST_PAD_MAX_PORTS; ++port)
+        {
+            m_source.slots_per_port[port] =
+                (port < m_source.port_count) ? std::min<uint32_t>(m_source.slots_per_port[port], PS2_HOST_PAD_MAX_SLOTS) : 0u;
+        }
+        m_hasSource = true;
+    }
+    else
+    {
+        m_source = Ps2HostPad{};
+        m_hasSource = false;
+    }
+}
+
+uint32_t PSPadBackend::portCount() const
+{
+    return m_hasSource ? m_source.port_count : 2u;
+}
+
+uint32_t PSPadBackend::slotCount(int port) const
+{
+    if (port < 0 || port >= static_cast<int>(portCount()))
+        return 0u;
+    return m_hasSource ? m_source.slots_per_port[port] : 1u;
+}
+
+void PSPadBackend::readHost(int port, int slot, Ps2HostPadState &out) const
+{
+    out = Ps2HostPadState{};
+    if (!m_hasSource || slot < 0 || static_cast<uint32_t>(slot) >= slotCount(port))
+        return;
+    m_source.read(m_source.user, port, slot, &out);
+}
+
+bool PSPadBackend::readState(int port, int slot, uint8_t *data, size_t size)
+{
+    if (!hostMode())
+        return readRaylibState(data, size);
+
+    if (!data || size < 32)
+        return false;
+    Ps2HostPadState state;
+    readHost(port, slot, state);
+    std::memset(data, 0, 32);
+    data[0] = 0x01;
+    data[1] = kPadAnalogMarker;
+    data[2] = static_cast<uint8_t>(state.buttons & 0xFFu);
+    data[3] = static_cast<uint8_t>(state.buttons >> 8);
+    data[4] = state.rx;
+    data[5] = state.ry;
+    data[6] = state.lx;
+    data[7] = state.ly;
+    if (state.has_pressure)
+        std::memcpy(data + 8, state.pressure, PS2_HOST_PAD_PRESSURE_COUNT);
+    return state.connected != 0;
+}
