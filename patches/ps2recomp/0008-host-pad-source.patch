diff --git a/ps2xRuntime/include/runtime/ps2_host_pad.h b/ps2xRuntime/include/runtime/ps2_host_pad.h
new file mode 100644
index 0000000..02cf2f0
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host_pad.h
@@ -0,0 +1,58 @@
+#ifndef PS2_HOST_PAD_H
+#define PS2_HOST_PAD_H
+
+#include <cstdint>
+
+// Host pad source: the state of the PS2 controllers comes from the program that embeds the runtime
+// (installed with PS2Runtime::setHostPad()) instead of from raylib.
+//
+// The runtime asks for the state of one (port, slot) each time the guest reads or queries that pad
+// (scePadRead, scePadGetState, scePadInfoMode, scePadInfoPressMode, scePadInfoAct). The call is made on
+// the game thread, in the middle of the guest's frame: the host's read callback must only copy a state
+// that its own thread (the one that polls the devices) has published (an atomic or a mutex-protected
+// struct); it must not block or call into the runtime.
+//
+// Ports and slots. A PS2 has two ports; a multitap on a port gives it up to four slots. The source
+// states how many of each it has, so that a four-player setup is described either as port 0 with
+// four slots {4, 1} or as two ports with two slots each {2, 2}. port_count is 0..PS2_HOST_PAD_MAX_PORTS,
+// slots_per_port[p] is 0..PS2_HOST_PAD_MAX_SLOTS. scePadGetPortMax returns port_count and
+// scePadGetSlotMax(port) returns slots_per_port[port]; a (port, slot) outside the description is not
+// openable (scePadPortOpen returns 0) and reads as not connected. The multitap functions (sceMtap*)
+// are not implemented by this interface, it only makes room for them.
+#define PS2_HOST_PAD_MAX_PORTS 2
+#define PS2_HOST_PAD_MAX_SLOTS 4
+
+// Order of the pressure bytes: the order of the pad data buffer bytes 8..19, i.e.
+// Right, Left, Up, Down, Triangle, Circle, Cross, Square, L1, L2, R1, R2.
+#define PS2_HOST_PAD_PRESSURE_COUNT 12
+
+struct Ps2HostPadState
+{
+    // 0: nothing plugged in (or the host has no state for it): the guest sees a disconnected pad.
+    uint8_t connected = 0;
+    // Active low, the layout of bytes 2-3 of the pad data buffer: Select 1<<0, L3 1<<1, R3 1<<2,
+    // Start 1<<3, Up 1<<4, Right 1<<5, Down 1<<6, Left 1<<7, L2 1<<8, R2 1<<9, L1 1<<10, R1 1<<11,
+    // Triangle 1<<12, Circle 1<<13, Cross 1<<14, Square 1<<15. 0xFFFF = nothing pressed.
+    uint16_t buttons = 0xFFFFu;
+    // 0..255, 0x80 centre (right X, right Y, left X, left Y; Y grows downwards as on the PS2).
+    uint8_t rx = 0x80, ry = 0x80, lx = 0x80, ly = 0x80;
+    // 0: the pressure bytes are derived from the buttons (0 or 255, what the runtime did before);
+    // 1: pressure[] is used. Either way they only reach the guest after scePadEnterPressMode.
+    uint8_t has_pressure = 0;
+    uint8_t pressure[PS2_HOST_PAD_PRESSURE_COUNT] = {};
+};
+
+struct Ps2HostPad
+{
+    // Passed back as the first argument of read.
+    void *user = nullptr;
+
+    uint32_t port_count = 0;
+    uint32_t slots_per_port[PS2_HOST_PAD_MAX_PORTS] = {};
+
+    // Fills *out (initialised to "not connected, nothing pressed") for the pad at (port, slot). Called
+    // only for a (port, slot) inside the description above. Required: a source without read is ignored.
+    void (*read)(void *user, int port, int slot, Ps2HostPadState *out) = nullptr;
+};
+
+#endif
