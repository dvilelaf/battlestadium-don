+#include "runtime/ps2_host_pad.h"
+
 #include <cstddef>
 #include <cstdint>
 
@@ -10,7 +12,37 @@ public:
     PSPadBackend() = default;
     ~PSPadBackend() = default;
 
+    // Fills the 32-byte buffer the pad handlers use (byte 1 mode marker, 2-3 buttons, 4-7 sticks,
+    // 8-19 pressure). Without a host source and without a host-owned window this is the runtime's own
+    // raylib mapping (gamepad 0 or the keyboard, port and slot ignored), as before. In host mode it
+    // is the host's state for (port, slot); returns false when that pad is not connected.
     bool readState(int port, int slot, uint8_t *data, size_t size);
+
+    // Installs (copies) the host source; nullptr, or a source without read, removes it. Call while the
+    // game thread is not running.
+    void setHostSource(const Ps2HostPad *source);
+    // The window, and with it the input devices, belong to the host (PS2Runtime::setHostOwnsWindow).
+    void setHostOwned(bool owned) { m_hostOwned = owned; }
+
+    // true when the pads do not come from raylib: a source is installed, or the host owns the window
+    // (then, without a source, every pad is not connected and raylib is never called).
+    bool hostMode() const { return m_hasSource || m_hostOwned; }
+    bool hasHostSource() const { return m_hasSource; }
+    const Ps2HostPad *hostSource() const { return m_hasSource ? &m_source : nullptr; }
+
+    // Host mode: the state of (port, slot) with connected=0 when there is no source, the (port, slot)
+    // is outside the source's description, or the source says so. Never calls raylib.
+    void readHost(int port, int slot, Ps2HostPadState &out) const;
+
+    // Number of ports and of slots of a port in the source's description (the defaults of the
+    // runtime's own pads, 2 and 1, without a source).
+    uint32_t portCount() const;
+    uint32_t slotCount(int port) const;
+
+private:
+    Ps2HostPad m_source{};
+    bool m_hasSource = false;
+    bool m_hostOwned = false;
 };
 
 #endif
