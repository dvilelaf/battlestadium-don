+void PS2Runtime::setHostGs(const Ps2HostGs *host)
+{
+    if (host && host->gif_transfer)
+    {
+        m_hostGsStorage = *host;
+        m_hostGs = true;
+    }
+    else
+    {
+        m_hostGsStorage = Ps2HostGs{};
+        m_hostGs = false;
+    }
+    const Ps2HostGs *installed = hostGs();
+    m_gifArbiter.setHostGs(installed, &m_memory.gs());
+    m_gs.setHostGs(installed, &m_gifArbiter);
+}
+
+void PS2Runtime::notifyHostGsVsync()
+{
+    if (!m_hostGs)
+        return;
+    m_gifArbiter.drain();
+    if (!m_hostGsStorage.vsync)
+        return;
+    GSRegisters &regs = m_memory.gs();
+    const uint64_t csr = regs.csr.load(std::memory_order_acquire);
+    const uint64_t privRegs[PS2_HOST_GS_PRIV_REG_COUNT] = {
+        regs.pmode, regs.smode1, regs.smode2, regs.srfsh, regs.synch1, regs.synch2, regs.syncv,
+        regs.dispfb1, regs.display1, regs.dispfb2, regs.display2, regs.extbuf, regs.extdata,
+        regs.extwrite, regs.bgcolor, csr, regs.imr, regs.busdir, regs.siglblid};
+    m_hostGsStorage.vsync(m_hostGsStorage.user, privRegs, static_cast<int>((csr >> 13) & 1u));
+}
