 {
+    if (m_hostGs)
+    {
+        m_hostArbiter->drain();
+        if (!dst || maxBytes == 0u || !m_hostGs->read_fifo)
+            return 0u;
+        return m_hostGs->read_fifo(m_hostGs->user, dst, maxBytes);
+    }
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     return m_backend ? m_backend->ConsumeLocalToHostBytes(dst, maxBytes) : 0u;
 }
