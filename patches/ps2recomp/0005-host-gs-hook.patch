diff --git a/ps2xRuntime/include/runtime/gs/ps2_host_gs.h b/ps2xRuntime/include/runtime/gs/ps2_host_gs.h
new file mode 100644
index 0000000..cd5dd24
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/ps2_host_gs.h
@@ -0,0 +1,62 @@
+#ifndef PS2_HOST_GS_H
+#define PS2_HOST_GS_H
+
+#include <cstdint>
+
+// Host GS: an optional replacement for the runtime's own GS, installed by the program that
+// embeds the runtime with PS2Runtime::setHostGs().
+//
+// With a host GS installed, the runtime does not draw: every GIF packet that its arbiter hands
+// to the GS is forwarded to gif_transfer, byte for byte and in the order the arbiter delivers
+// them, and at each vertical blank vsync receives the privileged registers. The runtime keeps
+// parsing the packets only for the three registers that a GS (but not the PCSX2 GS library)
+// reports back to the program: SIGNAL, FINISH and LABEL, plus the CSR and SIGLBLID bits they
+// set. The argument meanings and units match src/gsbridge/don_gs.h of the DON repository
+// (don_gs_gif_transfer, don_gs_vsync, don_gs_reset, don_gs_read_fifo), so connecting them is
+// one line each.
+//
+// Threads: the runtime runs the guest program on one thread (the "GameThread" started by
+// PS2Runtime::run(), the EE scheduler's executor). gif_transfer, vsync, reset, read_fifo and
+// thread_begin/thread_end are all called on that thread and never concurrently. This is the
+// thread that must own a GS library that requires every call from the thread that opened it:
+// open it in thread_begin and close it in thread_end. install/uninstall (setHostGs) must be
+// called while the game thread is not running.
+//
+// Every callback except gif_transfer may be null. A null gif_transfer is treated as "no host
+// GS installed".
+
+// Number of 64-bit values in the privileged-register array passed to vsync, in this order:
+// PMODE, SMODE1, SMODE2, SRFSH, SYNCH1, SYNCH2, SYNCV, DISPFB1, DISPLAY1, DISPFB2, DISPLAY2,
+// EXTBUF, EXTDATA, EXTWRITE, BGCOLOR, CSR, IMR, BUSDIR, SIGLBLID.
+#define PS2_HOST_GS_PRIV_REG_COUNT 19
+
+struct Ps2HostGs
+{
+    // Passed back as the first argument of every callback.
+    void *user = nullptr;
+
+    // Called once on the game thread before the first guest instruction runs, and (thread_end)
+    // once after the guest scheduler returns, even if it ended with an error. Optional.
+    void (*thread_begin)(void *user) = nullptr;
+    void (*thread_end)(void *user) = nullptr;
+
+    // GIF data of one packet. path is the GIF path 1 (VU1 XGKICK), 2 (VIF1 DIRECT/DIRECTHL) or
+    // 3 (the GIF DMA channel, and the runtime's own register writes for the sceGs* handlers).
+    // bytes is a multiple of 16 (a trailing partial quadword is dropped); data is valid only
+    // during the call.
+    void (*gif_transfer)(void *user, int path, const uint8_t *data, uint32_t bytes) = nullptr;
+
+    // One call per vertical blank, after every packet queued before it has been forwarded.
+    // priv_regs: PS2_HOST_GS_PRIV_REG_COUNT values (CSR with the runtime's FIELD bit and its
+    // SIGNAL/FINISH bits as the game sees them). field: 0 or 1, CSR.FIELD of this blank.
+    void (*vsync)(void *user, const uint64_t priv_regs[PS2_HOST_GS_PRIV_REG_COUNT], int field) = nullptr;
+
+    // The game wrote CSR.RESET (bit 9). Called after the packets queued before the write.
+    void (*reset)(void *user) = nullptr;
+
+    // GS to host transfer (TRXDIR = 1): copy up to bytes bytes of the image selected by the
+    // transfer registers into dst and return the number of bytes written (0 = nothing to read).
+    uint32_t (*read_fifo)(void *user, uint8_t *dst, uint32_t bytes) = nullptr;
+};
+
+#endif
