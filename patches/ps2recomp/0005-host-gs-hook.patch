 #include "runtime/gs/ps2_gif_arbiter.h"
+#include "runtime/gs/gs_types.h"
+#include "runtime/gs/ps2_host_gs.h"
+#include "runtime/ps2_memory.h"
 #include <algorithm>
 #include <cstring>
 
+namespace
+{
+    constexpr uint8_t kGifFmtPacked = 0;
+    constexpr uint8_t kGifFmtReglist = 1;
+    constexpr uint8_t kRegAd = 0x0E;
+
+    // The same effects as GS::writeRegisterUnlocked has for these registers (gs_frontend.cpp,
+    // cases GS_REG_SIGNAL, GS_REG_FINISH, GS_REG_LABEL, 0x59..0x5C, 0x5F), without the drawing
+    // state. Keep the two in step.
+    void applyStatusWrite(GSRegisters &regs, uint8_t reg, uint64_t value)
+    {
+        switch (reg)
+        {
+        case GS_REG_SIGNAL:
+        {
+            const uint32_t id = static_cast<uint32_t>(value & 0xFFFFFFFFu);
+            const uint32_t mask = static_cast<uint32_t>(value >> 32);
+            uint32_t lo = static_cast<uint32_t>(regs.siglblid & 0xFFFFFFFFu);
+            lo = (lo & ~mask) | (id & mask);
+            regs.siglblid = (regs.siglblid & 0xFFFFFFFF00000000ULL) | lo;
+            regs.csr.fetch_or(0x1);
+            break;
+        }
+        case GS_REG_FINISH:
+            regs.csr.fetch_or(0x2);
+            break;
+        case GS_REG_LABEL:
+        {
+            const uint32_t id = static_cast<uint32_t>(value & 0xFFFFFFFFu);
+            const uint32_t mask = static_cast<uint32_t>(value >> 32);
+            uint32_t hi = static_cast<uint32_t>(regs.siglblid >> 32);
+            hi = (hi & ~mask) | (id & mask);
+            regs.siglblid = (static_cast<uint64_t>(hi) << 32) | (regs.siglblid & 0xFFFFFFFFu);
+            break;
+        }
+        case 0x59:
+            regs.dispfb1 = value;
+            break;
+        case 0x5a:
+            regs.display1 = value;
+            break;
+        case 0x5b:
+            regs.dispfb2 = value;
+            break;
+        case 0x5c:
+            regs.display2 = value;
+            break;
+        case 0x5f:
+            regs.bgcolor = value;
+            break;
+        default:
+            break;
+        }
+    }
+}
+
+void GifHostScanner::reset()
+{
+    for (PathState &state : m_paths)
+        state = PathState{};
+}
+
+void GifHostScanner::feed(GifPathId pathId, const uint8_t *data, uint32_t sizeBytes, GSRegisters &regs)
+{
+    const uint32_t pathIndex = static_cast<uint32_t>(pathId) - 1u;
+    if (!data || pathIndex >= 3u)
+        return;
+    PathState &st = m_paths[pathIndex];
+
+    uint32_t offset = 0;
+    while (offset + 16u <= sizeBytes)
+    {
+        if (st.remaining == 0)
+        {
+            uint64_t tagLo = 0;
+            uint64_t tagHi = 0;
+            std::memcpy(&tagLo, data + offset, sizeof(tagLo));
+            std::memcpy(&tagHi, data + offset + 8, sizeof(tagHi));
+            offset += 16u;
+
+            const uint32_t nloop = static_cast<uint32_t>(tagLo & 0x7FFFu);
+            const uint8_t flg = static_cast<uint8_t>((tagLo >> 58) & 0x3u);
+            uint8_t nreg = static_cast<uint8_t>((tagLo >> 60) & 0xFu);
+            if (nreg == 0)
+                nreg = 16;
+
+            st.format = flg;
+            st.nreg = nreg;
+            st.position = 0;
+            st.hasAd = false;
+            for (uint32_t i = 0; i < nreg; ++i)
+            {
+                st.regs[i] = static_cast<uint8_t>((tagHi >> (i * 4u)) & 0xFu);
+                st.hasAd = st.hasAd || (st.regs[i] == kRegAd);
+            }
+
+            if (flg == kGifFmtPacked)
+                st.remaining = nloop * nreg;
+            else if (flg == kGifFmtReglist)
+                st.remaining = (nloop * nreg + 1u) / 2u;
+            else
+                st.remaining = nloop; // IMAGE, and the reserved value 3, which PCSX2 treats as IMAGE
+            continue;
+        }
+
+        const uint32_t available = (sizeBytes - offset) / 16u;
+        const uint32_t count = std::min(st.remaining, available);
+        if (st.format == kGifFmtPacked)
+        {
+            if (st.hasAd)
+            {
+                for (uint32_t i = 0; i < count; ++i)
+                {
+                    if (st.regs[(st.position + i) % st.nreg] != kRegAd)
+                        continue;
+                    uint64_t lo = 0;
+                    uint64_t hi = 0;
+                    std::memcpy(&lo, data + offset + i * 16u, sizeof(lo));
+                    std::memcpy(&hi, data + offset + i * 16u + 8u, sizeof(hi));
+                    applyStatusWrite(regs, static_cast<uint8_t>(hi & 0xFFu), lo);
+                }
+            }
+            st.position = (st.position + count) % st.nreg;
+        }
+        st.remaining -= count;
+        offset += count * 16u;
+    }
+}
