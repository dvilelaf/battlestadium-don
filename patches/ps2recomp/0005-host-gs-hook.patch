+        m_hostArbiter->submit(GifPathId::Path3, reinterpret_cast<const uint8_t *>(packet), sizeof(packet));
+        m_hostArbiter->drain();
+        return;
+    }
     std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
     writeRegisterUnlocked(regAddr, value);
 }
@@ -1628,6 +1638,13 @@ bool GS::clearActiveFramebuffer(uint32_t rgba)
 
