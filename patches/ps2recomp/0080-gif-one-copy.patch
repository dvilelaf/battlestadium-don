+void GifArbiter::submitNow(GifPathId pathId, const uint8_t *data, uint32_t sizeBytes, bool path2DirectHl)
+{
+    if (!m_hostGs || !m_queue.empty())
+    {
+        submit(pathId, data, sizeBytes, path2DirectHl);
+        drain();
+        return;
+    }
+    if (!data || sizeBytes < 16)
+        return;
+    const uint32_t bytes = sizeBytes & ~15u; // a GIF qword is 16 bytes: drop a partial one
+    if (m_privRegs)
+        m_scanner.feed(pathId, data, bytes, *m_privRegs);
+    m_hostGs->gif_transfer(m_hostGs->user, static_cast<int>(pathId), data, bytes);
+}
