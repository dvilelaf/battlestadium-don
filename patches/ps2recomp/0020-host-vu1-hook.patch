diff --git a/ps2xRuntime/include/runtime/ps2_host_vu1.h b/ps2xRuntime/include/runtime/ps2_host_vu1.h
new file mode 100644
index 0000000..e43a0c7
--- /dev/null
+++ b/ps2xRuntime/include/runtime/ps2_host_vu1.h
@@ -0,0 +1,117 @@
+#ifndef PS2_HOST_VU1_H
+#define PS2_HOST_VU1_H
+
+#include <cstdint>
+
+// Host VU1: an optional replacement for the runtime's own VU1 interpreter, installed by the program
+// that embeds the runtime with PS2Runtime::setHostVu1() (PS2Memory::setHostVu1() for tests). The DON
+// port connects PCSX2's microVU through src/vubridge/don_vu.h; the argument meanings and units of every
+// callback match that header (don_vu1_data, don_vu1_write_micro, don_vu1_set_top, don_vu1_execute,
+// don_vu1_continue, don_vu1_running, don_vu1_reset, don_vu1_set_regs, don_vu1_get_regs), so connecting
+// them is one line each.
+//
+// What stays in the runtime: VIF1 itself. The VIF1 interpreter (ps2_vif1_interpreter.cpp) still decodes
+// the command stream (STCYCL, OFFSET, BASE, ITOP, STMOD, STMASK, STROW, STCOL, MPG, UNPACK, FLUSH*,
+// MSCAL, MSCALF, MSCNT, DIRECT...) and keeps the VIF registers (TOPS, BASE, OFST, DBF...). With a host
+// VU1 installed and bound:
+//   * UNPACK writes land in the host's data memory (the pointer returned by data(), also the memory
+//     behind the EE-visible window at 0x1100C000), through the same code as without a host;
+//   * MPG uploads still update the runtime's mirror of the code memory (what the window at 0x11008000
+//     shows) and are also passed to write_micro; direct EE stores to that window are passed too;
+//   * MSCAL / MSCALF call execute(start_pc_bytes, ...), MSCNT calls execute(0xFFFFFFFF, ...), after
+//     set_top(TOP, ITOP) with the values the runtime's own VU1 would see in XTOP / XITOP;
+//   * XGKICK packets are delivered by the host VU1 to the sink that thread_begin receives, which hands
+//     them to the same GIF arbiter entry as the interpreter's XGKICK (path 1), so with a host GS they
+//     are forwarded to it and without one they reach the runtime's own GS.
+// Without a host VU1 (or if data() returns null) nothing changes: the runtime's interpreter runs.
+//
+// Threads: every callback is called on the game thread (the thread that runs the EE scheduler and with
+// it the DMA channels and the VIF1 FIFO; the same thread as the Ps2HostGs callbacks), never
+// concurrently, and the XGKICK sink is called on that thread from inside execute / continue_. A library
+// that must be opened and used on one thread (microVU) is opened in thread_begin and closed in
+// thread_end. thread_begin is called before data(); install/uninstall must happen while the game
+// thread is not running.
+//
+// Timing: the runtime does not model VU1 time. It gives each start (MSCAL/MSCNT) a budget of
+// PS2_HOST_VU1_SLICE_CYCLES cycles, the same figure the interpreter path uses, and then, while
+// running() says the program is not finished, continues it with the same budget, up to
+// PS2_HOST_VU1_MAX_SLICES slices per command. The returned cycle counts are only added to a statistic
+// (PS2Memory::hostVu1Stats()): nothing depends on their value, so engines that count differently
+// behave the same. A program still unfinished after the last slice is left suspended (as the runtime's
+// interpreter leaves it): the host library finishes it before it starts the next one.
+//
+// Everything except data, write_micro and execute may be null.
+
+#define PS2_HOST_VU1_SLICE_CYCLES 65536u
+#define PS2_HOST_VU1_MAX_SLICES 64u
+#define PS2_HOST_VU1_CONTINUE_PC 0xFFFFFFFFu // execute() start address of MSCNT: continue at the current TPC
+
+// Receives one complete GIF packet (tags and data up to and including the EOP tag, contiguous, a
+// multiple of 16 bytes, valid only during the call).
+typedef void (*Ps2HostVu1XgkickFn)(void *user, const uint8_t *packet, uint32_t bytes);
+
+// The XGKICK sink the runtime supplies: `user` is the PS2Memory (given to thread_begin). It submits the
+// packet on GIF path 1 and drains the arbiter, exactly like the interpreter's XGKICK.
+void ps2HostVu1Xgkick(void *memory, const uint8_t *packet, uint32_t bytes);
+
+struct Ps2HostVu1
+{
+    // Passed back as the first argument of every callback.
+    void *user = nullptr;
+
+    // Game thread, before the first guest instruction (thread_begin) and after the guest scheduler
+    // returns (thread_end). thread_begin receives the XGKICK sink and its user pointer: pass them to the
+    // library when opening it (don_vu1_open(sink, sink_user)). Optional.
+    void (*thread_begin)(void *user, Ps2HostVu1XgkickFn xgkick, void *xgkick_user) = nullptr;
+    void (*thread_end)(void *user) = nullptr;
+
+    // The 16 KiB of VU1 data memory (1024 quadwords) that UNPACK writes into. Valid after thread_begin.
+    // The runtime keeps using the returned pointer until thread_end. Required.
+    uint8_t *(*data)(void *user) = nullptr;
+
+    // Microcode upload: bytes at byte address addr_bytes of the 16 KiB code memory (VIF1 MPG, and EE
+    // stores to the code window). Required.
+    void (*write_micro)(void *user, uint32_t addr_bytes, const uint8_t *data, uint32_t bytes) = nullptr;
+
+    // The VIF1 TOP and ITOP registers (10 bits each) that XTOP / XITOP read, set before every start.
+    void (*set_top)(void *user, uint32_t top, uint32_t itop) = nullptr;
+
+    // Start a microprogram at byte address start_pc_bytes (MSCAL, MSCALF), or at the current TPC when it
+    // is PS2_HOST_VU1_CONTINUE_PC (MSCNT). Runs to its end or until about max_cycles have been used.
+    // Returns the cycles used. Required.
+    uint32_t (*execute)(void *user, uint32_t start_pc_bytes, uint32_t max_cycles) = nullptr;
+
+    // Continue a program that execute / continue_ stopped because of the budget. Returns cycles used.
+    uint32_t (*continue_)(void *user, uint32_t max_cycles) = nullptr;
+
+    // Nonzero while a program is stopped by its budget (VPU_STAT bit 8).
+    int (*running)(void *user) = nullptr;
+
+    // Reset registers and pipeline state (memories kept). Called once, right after thread_begin.
+    void (*reset)(void *user) = nullptr;
+
+    // Direct access to the registers: vf is 32 x 4 uint32, vi is 32 uint32 in the VU control register
+    // order (see don_vu.h). The runtime itself reads and writes none of them (the VIF only touches
+    // TOP/ITOP, passed with set_top); they are here for the host, tests and debuggers, through
+    // PS2Memory::hostVu1(). Optional.
+    void (*set_regs)(void *user, const void *vf, const void *vi) = nullptr;
+    void (*get_regs)(void *user, void *vf, void *vi) = nullptr;
+};
+
+// Counters of the host VU1 path (game thread only; read them when the game thread is not running).
+struct Ps2HostVu1Stats
+{
+    uint64_t executes = 0;       // MSCAL / MSCALF / MSCNT delegated to execute()
+    uint64_t continues = 0;      // continue_() slices
+    uint64_t cycles = 0;         // sum of the cycles returned (an engine-specific figure)
+    uint64_t unfinished = 0;     // starts still running after PS2_HOST_VU1_MAX_SLICES slices
+    uint64_t microWrites = 0;    // write_micro calls
+};
+
+// Receives each chunk handed to the VIF1 interpreter (DMA channel 1 data, FIFO writes), before it is
+// interpreted, one call per processVIF1Data call. Replaying the chunks, in order and with the same
+// sizes, through PS2Memory::processVIF1Data reproduces the stream. Works with or without a host VU1.
+// The data is valid only during the call.
+typedef void (*Ps2Vif1TapFn)(void *user, const uint8_t *data, uint32_t bytes);
+
+#endif
