+// ---- Host VU1 (ps2_host_vu1.h) ---------------------------------------------------------------------
+
+void ps2HostVu1Xgkick(void *memory, const uint8_t *packet, uint32_t bytes)
+{
+    // The same entry the runtime's interpreter uses for XGKICK (PATH1, drained immediately).
+    if (memory)
+        static_cast<PS2Memory *>(memory)->submitGifPacket(GifPathId::Path1, packet, bytes);
+}
+
+void PS2Memory::setHostVu1(const Ps2HostVu1 *host)
+{
+    if (m_hostVu1Installed)
+        endHostVu1();
+    if (host && host->data && host->write_micro && host->execute)
+    {
+        m_hostVu1 = *host;
+        m_hostVu1Installed = true;
+    }
+    else
+    {
+        m_hostVu1 = Ps2HostVu1{};
+        m_hostVu1Installed = false;
+    }
+}
+
+void PS2Memory::beginHostVu1()
+{
+    if (!m_hostVu1Installed || m_hostVu1Begun)
+        return;
+    m_hostVu1Begun = true;
+    if (m_hostVu1.thread_begin)
+        m_hostVu1.thread_begin(m_hostVu1.user, &ps2HostVu1Xgkick, this);
+    uint8_t *hostData = m_hostVu1.data(m_hostVu1.user);
+    if (!hostData || !m_vu1DataOwned)
+        return; // stays on the runtime's interpreter
+    if (m_hostVu1.reset)
+        m_hostVu1.reset(m_hostVu1.user);
+    // Carry over what is already in the runtime's memories (normally zero: this runs before any guest code).
+    std::memcpy(hostData, m_vu1DataOwned, PS2_VU1_DATA_SIZE);
+    for (uint32_t i = 0; i < PS2_VU1_CODE_SIZE; ++i)
+    {
+        if (m_vu1Code && m_vu1Code[i] != 0)
+        {
+            m_hostVu1.write_micro(m_hostVu1.user, 0, m_vu1Code, PS2_VU1_CODE_SIZE);
+            ++m_hostVu1Stats.microWrites;
+            break;
+        }
+    }
+    m_vu1Data = hostData;
+    m_hostVu1Bound = true;
+}
+
+void PS2Memory::endHostVu1()
+{
+    if (!m_hostVu1Begun)
+        return;
+    if (m_hostVu1Bound)
+    {
+        // Take the data memory back before the library is closed (its pointer dies in thread_end).
+        if (m_vu1DataOwned && m_vu1Data)
+            std::memcpy(m_vu1DataOwned, m_vu1Data, PS2_VU1_DATA_SIZE);
+        m_vu1Data = m_vu1DataOwned;
+        m_hostVu1Bound = false;
+    }
+    m_hostVu1Begun = false;
+    if (m_hostVu1.thread_end)
+        m_hostVu1.thread_end(m_hostVu1.user);
+}
+
+void PS2Memory::vu1CodeWritten(uint32_t offset, uint32_t bytes)
+{
+    markVU1CodeModified();
+    if (m_hostVu1Bound && m_vu1Code && offset < PS2_VU1_CODE_SIZE)
+    {
+        if (bytes > PS2_VU1_CODE_SIZE - offset)
+            bytes = PS2_VU1_CODE_SIZE - offset;
+        m_hostVu1.write_micro(m_hostVu1.user, offset, m_vu1Code + offset, bytes);
+        ++m_hostVu1Stats.microWrites;
+    }
+}
+
+void PS2Memory::runHostVu1(uint32_t startPC, uint32_t top, uint32_t itop)
+{
+    if (m_hostVu1.set_top)
+        m_hostVu1.set_top(m_hostVu1.user, top, itop);
+    m_hostVu1Stats.cycles += m_hostVu1.execute(m_hostVu1.user, startPC, PS2_HOST_VU1_SLICE_CYCLES);
+    ++m_hostVu1Stats.executes;
+    // Only the host's own "still running" answer decides whether to go on, never the cycle count.
+    uint32_t slices = 1;
+    while (m_hostVu1.continue_ && m_hostVu1.running && m_hostVu1.running(m_hostVu1.user))
+    {
+        if (slices >= PS2_HOST_VU1_MAX_SLICES)
+        {
+            ++m_hostVu1Stats.unfinished;
+            break;
+        }
+        m_hostVu1Stats.cycles += m_hostVu1.continue_(m_hostVu1.user, PS2_HOST_VU1_SLICE_CYCLES);
+        ++m_hostVu1Stats.continues;
+        ++slices;
+    }
+}
