# The shift-amount register (SA) is kept in bytes, as in the reference (R5900OpcodeImpl.cpp MFSA/MTSA/MTSAB/MTSAH,
# MMI.cpp QFSRV, which shifts by sa << 3). The port kept bits: mtsab/mtsah stored 8x/16x the byte count, mfsa returned
# bits and mtsa stored the value masked to 7 bits.
# Recompiler patch (emitted text): special_translator.cpp, regimm_translator.cpp, mmi_translation_helpers.cpp.
# Verified with tests/conformance (family mmi): mfsa, mtsa, mtsab, mtsah, qfsrv are equal to the reference with this
# patch and differ without it. The game cannot see the difference: its 3 sites that read/write SA (0x1160ac, 0x1162ec
# mfsa; 0x11619c mtsa) are interrupt-handler context save/restore, which hands the value back unchanged.
# Not in the series (T-210 piece 4).
# Regenerated 2026-10-13 on top of 0044: the context of the special_translator.cpp hunk named the movz/movn lines that 0044 changes.
diff --git a/ps2xRecomp/src/lib/mmi_translation_helpers.cpp b/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
index a2bcb77..b9fef0a 100644
--- a/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
+++ b/ps2xRecomp/src/lib/mmi_translation_helpers.cpp
@@ -601,7 +601,7 @@ namespace ps2recomp
         uint8_t rs = inst.rs;
         uint8_t rt = inst.rt;
         // QFSRV semantics are centralized in runtime macro helpers.
-        return fmt::format("SET_GPR_VEC(ctx, {}, PS2_QFSRV(GPR_VEC(ctx, {}), GPR_VEC(ctx, {}), ctx->sa & 0x7F));",
+        return fmt::format("SET_GPR_VEC(ctx, {}, PS2_QFSRV(GPR_VEC(ctx, {}), GPR_VEC(ctx, {}), (ctx->sa << 3) & 0x7F));",
                            rd, rs, rt);
     }
 
