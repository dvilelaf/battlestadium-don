         return (uint32_t)(sa > sb ? sa : sb);
     return (uint32_t)(sa < sb ? sa : sb);
 }
+// vmax and vmini (VUops.cpp: applyMinMax, fp_max/fp_min of FPU.cpp): per lane, the bit patterns ordered as signed integers, two
+// negative ones the other way round. -0 < +0 and a denormal pattern is a number, unlike _mm_max_ps / _mm_min_ps.
+static inline __m128i ps2_vu_order_key(__m128 x)
+{
+    const __m128i i = _mm_castps_si128(x);
+    return _mm_xor_si128(i, _mm_srli_epi32(_mm_srai_epi32(i, 31), 1));
+}
+static inline __m128 ps2_vu_max_ps(__m128 a, __m128 b)
+{
+    return _mm_blendv_ps(b, a, _mm_castsi128_ps(_mm_cmpgt_epi32(ps2_vu_order_key(a), ps2_vu_order_key(b))));
+}
+static inline __m128 ps2_vu_min_ps(__m128 a, __m128 b)
+{
+    return _mm_blendv_ps(b, a, _mm_castsi128_ps(_mm_cmplt_epi32(ps2_vu_order_key(a), ps2_vu_order_key(b))));
+}
 #define FPU_CVT_L_S(a) ((int64_t)(float)(a))
 #define FPU_C_F_S(a, b) (0)
 #define FPU_C_UN_S(a, b) (isnan((float)(a)) || isnan((float)(b)))
