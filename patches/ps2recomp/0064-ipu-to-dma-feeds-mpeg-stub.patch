+uint32_t PS2Memory::ipuToPull(std::vector<uint8_t> &out, uint32_t maxBytes)
+{
+    static constexpr uint32_t kChannel = 0x1000B400u;
+    static constexpr uint32_t kChcr = kChannel + 0x00u;
+    static constexpr uint32_t kMadr = kChannel + 0x10u;
+    static constexpr uint32_t kQwc = kChannel + 0x20u;
+    static constexpr uint32_t kTadr = kChannel + 0x30u;
+    static constexpr uint32_t kAsr0 = kChannel + 0x40u;
+    static constexpr uint32_t kAsr1 = kChannel + 0x50u;
+    static constexpr uint32_t kCause = 4u;
+
+    uint32_t chcr = m_ioRegisters[kChcr];
+    if (!m_ipuToStarted || maxBytes < 16u)
+        return 0u;
+
+    const uint32_t mode = (chcr >> 2u) & 0x3u;
+    uint32_t madr = m_ioRegisters[kMadr];
+    uint32_t qwc = m_ioRegisters[kQwc] & 0xFFFFu;
+    uint32_t tadr = m_ioRegisters[kTadr];
+    uint32_t asr0 = m_ioRegisters[kAsr0];
+    uint32_t asr1 = m_ioRegisters[kAsr1];
+    uint32_t asp = (chcr >> 4u) & 0x3u;
+    // CHCR bits 28-30 hold the id of the tag whose payload is being sent: what follows it.
+    uint32_t tagId = (chcr >> 28u) & 0x7u;
+    uint32_t pulled = 0u;
+    bool finished = false;
+
+    auto isEndId = [](uint32_t id) { return id == 0u || id == 7u; };
+
+    while (pulled + 16u <= maxBytes)
+    {
+        if (qwc == 0u)
+        {
+            if (mode != 1u)
+            {
+                finished = true;
+                break;
+            }
+            const uint32_t tagPhys = tadr & 0x1FFFFFF0u;
+            const bool tagSpr = isScratchpad(tadr);
+            const uint8_t *base = tagSpr ? m_scratchpad : m_rdram;
+            const uint32_t limit = tagSpr ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+            const uint32_t tagOff = tagSpr ? (tadr & (PS2_SCRATCHPAD_SIZE - 1u)) : (tagPhys & (PS2_RAM_SIZE - 1u));
+            if (tagOff + 16u > limit)
+            {
+                finished = true;
+                break;
+            }
+            uint64_t tag = 0;
+            std::memcpy(&tag, base + tagOff, sizeof(tag));
+            qwc = static_cast<uint32_t>(tag & 0xFFFFu);
+            tagId = static_cast<uint32_t>((tag >> 28u) & 0x7u);
+            const uint32_t addr = static_cast<uint32_t>((tag >> 32u) & 0x7FFFFFFFu);
+            chcr = (chcr & 0x0000FFFFu) | (static_cast<uint32_t>((tag >> 16u) & 0xFFFFu) << 16u);
+            switch (tagId)
+            {
+            case 0u: // refe
+            case 3u: // ref
+            case 4u: // refs
+                madr = addr;
+                tadr += 16u;
+                break;
+            case 1u: // cnt
+            case 7u: // end
+                madr = tadr + 16u;
+                tadr = madr + qwc * 16u;
+                break;
+            case 2u: // next
+                madr = tadr + 16u;
+                tadr = addr;
+                break;
+            case 5u: // call
+                madr = tadr + 16u;
+                if (asp == 0u)
+                    asr0 = madr + qwc * 16u;
+                else if (asp == 1u)
+                    asr1 = madr + qwc * 16u;
+                if (asp < 2u)
+                    ++asp;
+                tadr = addr;
+                break;
+            default: // ret
+                madr = tadr + 16u;
+                if (asp == 2u)
+                {
+                    tadr = asr1;
+                    asp = 1u;
+                }
+                else if (asp == 1u)
+                {
+                    tadr = asr0;
+                    asp = 0u;
+                }
+                else
+                    tagId = 7u;
+                break;
+            }
+            if (qwc == 0u)
+            {
+                if (isEndId(tagId))
+                {
+                    finished = true;
+                    break;
+                }
+                continue;
+            }
+        }
+
+        const uint32_t room = (maxBytes - pulled) / 16u;
+        const uint32_t take = std::min(qwc, room);
+        if (take == 0u)
+            break;
+        const bool spr = isScratchpad(madr);
+        const uint8_t *base = spr ? m_scratchpad : m_rdram;
+        const uint32_t limit = spr ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+        const uint32_t off = spr ? (madr & (PS2_SCRATCHPAD_SIZE - 1u)) : (madr & 0x1FFFFFF0u & (PS2_RAM_SIZE - 1u));
+        const uint32_t bytes = std::min(take * 16u, limit - off);
+        out.insert(out.end(), base + off, base + off + bytes);
+        pulled += bytes;
+        madr += bytes;
+        qwc -= bytes / 16u;
+        if (qwc == 0u && (mode != 1u || isEndId(tagId)))
+        {
+            finished = true;
+            break;
+        }
+    }
+
+    m_ioRegisters[kMadr] = madr;
+    m_ioRegisters[kQwc] = qwc;
+    m_ioRegisters[kTadr] = tadr;
+    m_ioRegisters[kAsr0] = asr0;
+    m_ioRegisters[kAsr1] = asr1;
+    chcr = (chcr & ~(0x3u << 4u)) | ((asp & 0x3u) << 4u);
+    m_ioRegisters[kChcr] = chcr;
+    if (finished)
+    {
+        m_ipuToStarted = false;
+        completeDmacChannel(kChannel, kCause);
+    }
+    return pulled;
+}
+
 void PS2Memory::completeDmacChannel(uint32_t channelBase, uint32_t cause)
 {
     static constexpr uint32_t kDStat = 0x1000E010u;
