     if (decodeEeTimerRegister(address, timerIndex, timerOffset))
     {
+        m_pendingEeTimerInterruptMask |= flushEeTimers(); // patch 0035: read the value as of now
         const EeTimer &timer = m_eeTimers[timerIndex];
         switch (timerOffset)
         {
