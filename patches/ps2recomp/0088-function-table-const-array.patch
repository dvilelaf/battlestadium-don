     m_donHot.fnTableEnd = g_ps2RecompiledFunctionTableEnd;
     m_donHot.fnTableSlots = g_ps2RecompiledFunctionTableSlotCount;
     m_donHot.fnTable = g_ps2RecompiledFunctionTable;
+    ps2FillRecompiledFunctionTable(don_game_module());
     m_iopHost = std::make_unique<PS2IopHostAdapter>(*this);
     m_iopSubsystem = std::make_unique<ps2x::iop::IopSubsystem>(*m_iopHost);
 
