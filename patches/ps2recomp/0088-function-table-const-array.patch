diff --git a/ps2xRuntime/include/ps2_runtime.h b/ps2xRuntime/include/ps2_runtime.h
index 6c1ee3d..a23c315 100644
--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -669,6 +669,26 @@ extern const uint32_t g_ps2RecompiledFunctionTableEnd;
 extern const uint32_t g_ps2RecompiledFunctionTableSlotCount;
 extern PS2Runtime::RecompiledFunction g_ps2RecompiledFunctionTable[];
 
+// The generated code holds a constant {address, function} array; the PS2Runtime constructor copies it into the
+// writable table above, where overrides keep writing.
+struct DonFunctionEntry
+{
+    uint32_t address;
+    PS2Runtime::RecompiledFunction function;
+};
+
+struct DonGameModule
+{
+    const DonFunctionEntry *entries;
+    uint32_t count;
+};
+
+const DonGameModule &don_game_module();
+
+// Copies a module's entries into g_ps2RecompiledFunctionTable. An address outside the table (or not word-aligned)
+// prints a [don] message with the address and aborts. Called by the PS2Runtime constructor.
+void ps2FillRecompiledFunctionTable(const DonGameModule &module);
+
 // Whether the last 64 dispatched guest addresses are recorded (DON_DISPATCH_HISTORY=1; they only appear in the
 // missing-function report). Read once at start-up; plain bool so the dispatch fast path pays one load.
 extern bool g_ps2DispatchHistoryEnabled;
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index f001e50..089eb4d 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -483,6 +483,24 @@ static void UploadFrame(Texture2D &tex, PS2Runtime *rt, uint32_t &outWidth, uint
 }
 #endif // PS2X_NO_RAYLIB
 
+void ps2FillRecompiledFunctionTable(const DonGameModule &module)
+{
+    for (uint32_t i = 0; i < module.count; ++i)
+    {
+        const uint32_t address = module.entries[i].address;
+        const uint32_t slot = (address - g_ps2RecompiledFunctionTableBase) >> 2;
+        if (address < g_ps2RecompiledFunctionTableBase || (address & 3u) != 0u ||
+            slot >= g_ps2RecompiledFunctionTableSlotCount)
+        {
+            std::fprintf(stderr, "[don] function table entry %u has address 0x%08X outside [0x%08X, 0x%08X) (%u slots)\n",
+                         i, address, g_ps2RecompiledFunctionTableBase, g_ps2RecompiledFunctionTableEnd,
+                         g_ps2RecompiledFunctionTableSlotCount);
+            std::abort();
+        }
+        g_ps2RecompiledFunctionTable[slot] = module.entries[i].function;
+    }
+}
+
 PS2Runtime::PS2Runtime()
 {
     m_memory.bindHotState(&m_donHot);
