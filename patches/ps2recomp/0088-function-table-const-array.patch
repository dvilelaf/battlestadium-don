+#ifndef _WIN32
+// The fill aborts on a bad entry, so the check runs in a child process. Returns true when the child was killed by SIGABRT.
+static bool fillAbortsInChild(const DonGameModule &module)
+{
+    const pid_t pid = fork();
+    if (pid == 0)
+    {
+        ps2FillRecompiledFunctionTable(module);
+        _exit(0);
+    }
+    int status = 0;
+    waitpid(pid, &status, 0);
+    return WIFSIGNALED(status) && WTERMSIG(status) == SIGABRT;
+}
+#endif
+
