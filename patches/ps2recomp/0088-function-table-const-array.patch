+            const DonGameModule module = {entries, 2u};
+            ps2FillRecompiledFunctionTable(module);
+            t.IsTrue(g_ps2RecompiledFunctionTable[0] == entries[0].function, "address 0 fills slot 0");
+            t.IsTrue(g_ps2RecompiledFunctionTable[0x1004u >> 2] == entries[1].function, "address 0x1004 fills slot 0x401");
+            t.IsTrue(g_ps2RecompiledFunctionTable[1] == nullptr, "other slots stay empty");
+            reset_ps2_test_function_table();
+        });
+
