+        tc.Run("function table fill aborts on an unaligned address", [](TestCase &t)
+        {
+            const DonFunctionEntry entries[] = {{0x1002u, (PS2Runtime::RecompiledFunction)0x40}};
+            const DonGameModule module = {entries, 1u};
+            t.IsTrue(fillAbortsInChild(module), "unaligned entry aborts the fill with SIGABRT");
+        });
