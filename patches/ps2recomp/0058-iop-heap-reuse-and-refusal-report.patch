         return result;
     }
 
+    std::vector<IopMemory::Allocation> IopMemory::sortedAllocations() const
+    {
+        std::vector<Allocation> blocks = m_allocations;
+        std::sort(blocks.begin(), blocks.end(),
+                  [](const Allocation &a, const Allocation &b)
+                  { return a.address < b.address; });
+        return blocks;
+    }
+
+    // Patch 0058: a refused request is never silent (the effects driver died for weeks on a zero returned here).
+    // The first four refusals of one size are printed in full, then every hundredth with its count.
+    void IopMemory::reportRefusal(uint32_t size, uint32_t alignment, std::optional<uint32_t> fixed)
+    {
+        const uint32_t count = ++m_refusals[size];
+        if (count > 4u && count % 100u != 0u)
+            return;
+        std::fprintf(stderr,
+                     "[ps2xIOP] heap request refused (#%" PRIu32 " of this size): size=%#" PRIx32 " alignment=%" PRIu32
+                     " fixed=%#" PRIx32 " largest free gap=%#" PRIx32 " total free=%#" PRIx32 "\n",
+                     count, size, alignment, fixed ? *fixed : 0u, maxFreeMemory(), totalFreeMemory());
+    }
+
     uint32_t IopMemory::allocate(uint32_t size, uint32_t alignment, std::optional<uint32_t> fixed)
     {
         size = alignUp(std::max(size, 1u), 16u);
@@ -378,38 +402,48 @@ namespace ps2x::iop::detail
         if (fixed)
         {
             const uint32_t address = *fixed;
-            if (address < HeapBase || address + size > HeapLimit)
-                return 0u;
+            bool ok = address >= HeapBase && address + size <= HeapLimit;
             for (const auto &block : m_allocations)
-                if (address < block.address + block.size && block.address < address + size)
-                    return 0u;
+                if (ok && address < block.address + block.size && block.address < address + size)
+                    ok = false;
