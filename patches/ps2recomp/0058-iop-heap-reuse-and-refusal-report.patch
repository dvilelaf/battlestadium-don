-        uint32_t candidate = alignUp(m_heapCursor, alignment);
-        for (;;)
+        // First fit, from the heap's base: freed space is offered again.
+        uint32_t found = 0u;
+        uint32_t cursor = HeapBase;
+        for (const auto &block : sortedAllocations())
         {
-            bool overlap = false;
-            for (const auto &block : m_allocations)
