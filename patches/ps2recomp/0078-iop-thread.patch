+void PS2IopHostAdapter::drainDeferred()
+{
+    if (m_deferred.empty())
+        return;
+    std::vector<DeferredOp> ops;
+    ops.swap(m_deferred);
+    for (const DeferredOp &op : ops)
+    {
+        switch (op.kind)
+        {
+        case DeferredOp::Write:
+            (void)writeGuest(op.address, op.data.data(), op.size);
+            break;
+        case DeferredOp::Zero:
+            (void)zeroGuest(op.address, op.size);
+            break;
+        case DeferredOp::Command:
+            (void)sendSifCommand(op.address, op.data.data(), op.size);
+            break;
+        }
+    }
+}
