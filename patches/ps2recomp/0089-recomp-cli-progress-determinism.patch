+        // Reads the "target_address,owner_address" list (hex, one pair per line). Returns "" or what is wrong.
+        std::string loadResumeOwners(const std::string &path, std::map<uint32_t, uint32_t> &owners)
+        {
+            std::ifstream in(path);
+            if (!in)
+            {
+                return "Cannot read resume owner list: " + path;
+            }
+            std::string line;
+            if (!std::getline(in, line) || line != "target_address,owner_address")
+            {
+                return "Resume owner list " + path + ": first line is not 'target_address,owner_address'";
+            }
+            owners.clear();
+            size_t lineNumber = 1;
+            while (std::getline(in, line))
+            {
+                ++lineNumber;
+                const size_t comma = line.find(',');
+                try
+                {
+                    if (comma == std::string::npos)
+                    {
+                        throw std::invalid_argument("no comma");
+                    }
+                    size_t used = 0;
+                    const uint32_t target = static_cast<uint32_t>(std::stoul(line.substr(0, comma), &used, 16));
+                    if (used != comma)
+                    {
+                        throw std::invalid_argument("trailing text");
+                    }
+                    const std::string ownerText = line.substr(comma + 1);
+                    const uint32_t owner = static_cast<uint32_t>(std::stoul(ownerText, &used, 16));
+                    if (used != ownerText.size() || !owners.emplace(target, owner).second)
+                    {
+                        throw std::invalid_argument("trailing text or repeated target");
+                    }
+                }
+                catch (const std::exception &)
+                {
+                    return "Resume owner list " + path + ": bad line " + std::to_string(lineNumber);
+                }
+            }
+            return "";
+        }
