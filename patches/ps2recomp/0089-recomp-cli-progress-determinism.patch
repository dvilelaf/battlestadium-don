new file mode 100644
index 0000000..4713b82
--- /dev/null
+++ b/ps2xRecomp/include/ps2recomp/recompiler_exit.h
@@ -0,0 +1,34 @@
+#ifndef PS2RECOMP_RECOMPILER_EXIT_H
+#define PS2RECOMP_RECOMPILER_EXIT_H
+
+#include <stdexcept>
+#include <string>
+
+namespace ps2recomp
+{
+    // Process exit codes of ps2_recomp. The only place they are defined.
+    constexpr int kExitOk = 0;
+    constexpr int kExitBadInput = 2;      // bad command line, unreadable or invalid config, missing or unparsable ELF
+    constexpr int kExitIoError = 3;       // the output folder or an output file cannot be created or written
+    constexpr int kExitInternalError = 4; // anything else (a bug or an unexpected exception)
+
+    // Number of generated files between two "[progress] <done>/<total>" lines (the first and last are always printed).
+    constexpr size_t kProgressStep = 1000;
+
+    enum class FailureKind
+    {
+        None,
+        BadInput,
+        Io,
+        Internal
+    };
+
+    // Thrown when writing an output file or creating the output folder fails.
+    class IoError : public std::runtime_error
+    {
+    public:
+        explicit IoError(const std::string &what) : std::runtime_error(what) {}
+    };
+}
+
+#endif // PS2RECOMP_RECOMPILER_EXIT_H
