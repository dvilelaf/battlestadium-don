     static constexpr uint64_t kEeClockHz = 294912000ull;
     static constexpr uint32_t kGeneratedCheckpointCycles = 32u;
     static constexpr uint32_t kGuestDispatchCycles = 8u;
+    // Patch 0041: how soon (EE cycles, 8 dispatches) the slow path looks again at a deferred handler or at a
+    // slice that ended inside a DI ... EI section.
+    static constexpr uint64_t kInterruptRecheckCycles = 64u;
     static constexpr uint64_t kDefaultTimeSliceCycles = 65536ull;
 
     explicit EeScheduler(PS2Runtime &runtime);
@@ -438,6 +441,10 @@ private:
     void updateFastPathCycle() noexcept;
     [[nodiscard]] bool hasReadyAtOrAbovePriority(int priority) const;
     void renewTimeSlice();
+    // Patch 0041: an interrupt handler does not start, and the time slice does not expire, while the context
+    // that would be interrupted has interrupts disabled (see EeScheduler.cpp, interruptsEnabled).
+    [[nodiscard]] static bool interruptsEnabled(const R5900Context &context) noexcept;
+    [[nodiscard]] static bool isInterruptInvocation(const GuestInvocation &invocation) noexcept;
     void copyMainContextToRuntime();
     void publishDebugContext(const R5900Context &context);
     void publishIdleDebugContext();
@@ -487,6 +494,8 @@ private:
     // and the next IOP batch) and its counters. m_snapshotRequested is set by snapshot() (any thread) and
     // consumed by the slow path on the executor thread.
     uint64_t m_nextFastPathCycle = 0;
+    // Patch 0041: a queued interrupt handler is waiting for the running context to enable interrupts.
+    bool m_interruptsDeferred = false;
     uint64_t m_dispatchCount = 0;
     uint64_t m_fastPathCount = 0;
     uint64_t m_slowPathCount = 0;
