+    if (m_interruptsDeferred && m_eeCycle + kInterruptRecheckCycles < next)
+    {
+        next = m_eeCycle + kInterruptRecheckCycles; // patch 0041: a deferred handler is looked at again soon
+    }
     const uint64_t deadline = m_nextDeadlineCycle.load(std::memory_order_acquire);
     if (deadline != 0u && deadline < next)
     {
@@ -480,6 +519,24 @@ EeDispatchStats EeScheduler::dispatchStats() const noexcept
     return stats;
 }
 
+bool EeScheduler::interruptsEnabled(const R5900Context &context) noexcept
+{
+    // Patch 0041: the three things that keep the console from taking an interrupt: the DI/EI bit
+    // (EIE, bit 16, which the recompiled DI and EI clear and set), the master enable (IE, bit 0), and
+    // being inside an exception (EXL, bit 1, or ERL, bit 2).
+    const uint32_t status = context.cop0_status;
+    return (status & 0x10000u) != 0u && (status & 0x1u) != 0u && (status & 0x6u) == 0u;
+}
+
+bool EeScheduler::isInterruptInvocation(const GuestInvocation &invocation) noexcept
+{
+    // The invocations that stand for a hardware interrupt: the INTC/DMAC handlers, the alarm (timer)
+    // and the GS vertical-blank callback. The RPC, SIF command, syscall-override, exit-handler and HLE
+    // invocations are the runtime's own calls, not interrupts.
+    return invocation.kind == GuestInvocationKind::Interrupt || invocation.kind == GuestInvocationKind::Alarm ||
+           invocation.kind == GuestInvocationKind::GsCallback;
+}
