+#pragma once
+
+// Piece 1 of the direct-call work: the inline fast path of PS2Runtime::dispatchGuestBranch. Included only
+// from the end of ee_scheduler.h, where EeScheduler is complete (ps2_runtime.h includes that header at its
+// end, so every file that sees PS2Runtime sees this).
+#include "ps2_runtime.h"
+#include "runtime/ee_scheduler.h"
+
+inline bool PS2Runtime::dispatchGuestBranch(uint8_t *rdram,
+                                            R5900Context *ctx,
+                                            uint32_t targetPc,
+                                            uint32_t sourcePc,
+                                            uint32_t fallthroughPc,
+                                            GuestBranchKind kind,
+                                            const char *debugName)
+{
+    ctx->pc = targetPc;
+
+    // Every inter-function transfer is also a deterministic EE safe point (the same 8-cycle charge, at the
+    // same point, as the out-of-line version had).
+    if (m_eeScheduler && m_eeScheduler->checkpointDue(EeScheduler::kGuestDispatchCycles))
+    {
+        return false;
+    }
+
+    if ((kind == GuestBranchKind::DirectCall || kind == GuestBranchKind::IndirectCall) &&
+        (targetPc & 3u) == 0u && targetPc >= g_ps2RecompiledFunctionTableBase &&
+        targetPc < g_ps2RecompiledFunctionTableEnd &&
+        ((targetPc - g_ps2RecompiledFunctionTableBase) >> 2) < g_ps2RecompiledFunctionTableSlotCount)
+    {
+        const RecompiledFunction targetFn =
+            g_ps2RecompiledFunctionTable[(targetPc - g_ps2RecompiledFunctionTableBase) >> 2];
+        if (targetFn != nullptr)
+        {
+            if (g_ps2DispatchHistoryEnabled)
+            {
+                ps2PushDispatchPc(targetPc);
+            }
+
+            targetFn(rdram, ctx, this);
+
+            if (isStopRequested() || ctx->pc == 0u)
+            {
+                return false;
+            }
+
+            // Patch 0054: a checkpoint answered "due" somewhere below: ctx->pc is where the guest resumes,
+            // not the callee's return, even when it equals this callee's entry (a recursive call being
+            // unwound).
+            if (m_eeScheduler && m_eeScheduler->unwinding())
+            {
+                return false;
+            }
+
+            if (ctx->pc == targetPc)
+            {
+                ctx->pc = fallthroughPc;
+            }
+
+            return ctx->pc == fallthroughPc;
+        }
+    }
+
+    return dispatchGuestBranchTail(rdram, ctx, targetPc, sourcePc, fallthroughPc, kind, debugName);
+}
