+std::vector<uint8_t> PS2Memory::acquireChainBuffer()
+{
+    if (!m_chainBufferPool.empty())
+    {
+        std::vector<uint8_t> buf = std::move(m_chainBufferPool.back());
+        m_chainBufferPool.pop_back();
+        buf.clear();
+        return buf;
+    }
+    std::vector<uint8_t> buf;
+    buf.reserve(64u * 1024u);
+    return buf;
+}
+
+void PS2Memory::recycleTransfers(std::vector<PendingTransfer> &transfers)
+{
+    for (auto &t : transfers)
+    {
+        if (t.chainData.capacity() != 0u && m_chainBufferPool.size() < 8u)
+        {
+            t.chainData.clear();
+            m_chainBufferPool.push_back(std::move(t.chainData));
+        }
+    }
+    transfers.clear();
+}
