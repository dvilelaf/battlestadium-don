--- /dev/null
+++ b/ps2xIOP/include/ps2x/iop/iop_native_module.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#include <cstdint>
+
+// One ahead-of-time translated IOP module (patch 0085). The emulator calls `run` instead of interpreting when the
+// guest reaches one of `entryPcs` and nothing prevents it (no branch or load pending, no interrupt deliverable).
+// `run` returns the number of instructions it executed, which are also its cycles, never more than `budget`, and
+// leaves the CPU exactly as the interpreter would after that many instructions (see tools/iop_recomp/emit_adxi.py).
+//   DON_IOP_NATIVE=0           the module is never used
+//   DON_IOP_NATIVE_VERIFY=1    every native stretch is replayed by the interpreter and compared; differences are
+//                              reported as `[don-iop] native verify ...` and the interpreter's result is kept
+namespace ps2x::iop
+{
+    namespace detail
+    {
+        struct IopCpuState;
+        class IopMemory;
+    }
+
+    struct IopNativeModule
+    {
+        const char *name = "";
+        uint32_t codeLo = 0;   // guest address of the first translated word
+        uint32_t codeSize = 0; // bytes
+        uint64_t codeHash = 0; // FNV-1a (64 bit) of the code bytes, checked once before first use
+        const uint32_t *entryPcs = nullptr;
+        uint32_t numEntryPcs = 0;
+        uint32_t (*run)(detail::IopCpuState &, detail::IopMemory &, uint32_t budget) = nullptr;
+        bool (*stale)() = nullptr;      // optional: true after a store into the code was handed to the interpreter
+        void (*resetStale)() = nullptr; // optional
+    };
+
+    struct IopNativeStats
+    {
+        uint64_t calls = 0;        // run() calls that executed at least one instruction
+        uint64_t instructions = 0; // instructions executed natively
+        uint64_t verifyDifferences = 0;
+        bool active = false; // registered, hash accepted and not disabled
+        bool disabled = false;
+    };
+
+    // Registers the module for every emulator created or reset afterwards (one module; a second call replaces it).
+    // The pointed-to descriptor must outlive the emulator. Pass nullptr to unregister.
+    void registerNativeModule(const IopNativeModule *module);
+    [[nodiscard]] IopNativeStats nativeModuleStats();
+}
