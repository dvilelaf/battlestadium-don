+// program: the same result and instruction count as the interpreter, the hash guard, the disable-on-write rule,
+// DON_IOP_NATIVE=0 and the verify mode. The real translator is tested by tests/test_iop_emit.py in the DON repository.
+#include "iop_compat_test_support.h"
+
+#include "core/iop_cpu.h"
+#include "core/iop_memory.h"
+#include "ps2x/iop/iop_native_module.h"
+
+#include <cstdlib>
+#include <iostream>
+
+namespace
+{
+    using namespace ps2x::iop;
+    using ps2x::iop::detail::IopCpuState;
+    using ps2x::iop::detail::IopMemory;
+
+    constexpr uint32_t kBase = 0x10000u;
+    constexpr uint32_t kEntry = kBase + 4u;
+    constexpr uint32_t kWords[] = {
+        0x24020000u, // 10000 addiu v0, zero, 0
+        0x24420001u, // 10004 addiu v0, v0, 1   <- native entry
+        0x24420001u, // 10008 addiu v0, v0, 1
+        0x24420001u, // 1000c addiu v0, v0, 1
+        0x24420001u, // 10010 addiu v0, v0, 1
+        0x03E00008u, // 10014 jr ra
+        0x00000000u, // 10018 nop
+    };
+    constexpr uint32_t kCodeBytes = sizeof(kWords);
+
+    uint64_t fnv(const uint32_t *words, size_t count)
+    {
+        uint64_t h = 0xCBF29CE484222325ull;
+        for (size_t i = 0; i < count; ++i)
+            for (int b = 0; b < 4; ++b)
+                h = (h ^ ((words[i] >> (8 * b)) & 0xFFu)) * 0x100000001B3ull;
+        return h;
+    }
+
+    uint32_t runGood(IopCpuState &cpu, IopMemory &, uint32_t budget)
+    {
+        if (cpu.pc != kEntry || cpu.branchPending || cpu.pendingLoad || budget < 4u)
+            return 0u;
+        cpu.gpr[2] += 4u;
+        cpu.pc = kBase + 0x14u;
+        return 4u;
+    }
+
+    uint32_t runBad(IopCpuState &cpu, IopMemory &mem, uint32_t budget)
+    {
+        const uint32_t n = runGood(cpu, mem, budget);
+        if (n != 0u)
+            cpu.gpr[2] += 1u; // a wrong result
+        return n;
+    }
+
+    const uint32_t kEntries[] = {kEntry};
+
+    IopNativeModule module(uint32_t (*run)(IopCpuState &, IopMemory &, uint32_t), bool goodHash = true)
+    {
+        IopNativeModule m;
+        m.name = "synthetic";
+        m.codeLo = kBase;
+        m.codeSize = kCodeBytes;
+        m.codeHash = fnv(kWords, kCodeBytes / 4u) ^ (goodHash ? 0ull : 1ull);
+        m.entryPcs = kEntries;
+        m.numEntryPcs = 1;
+        m.run = run;
+        return m;
+    }
+
+    void setEnv(const char *name, const char *value)
+    {
+#ifdef _WIN32
+        _putenv_s(name, value ? value : "");
+#else
+        if (value)
+            setenv(name, value, 1);
+        else
+            unsetenv(name);
+#endif
+    }
+
+    struct Outcome
+    {
+        int32_t start = 0;
+        uint64_t instructions = 0;
+        IopNativeStats stats;
+        bool logged = false;
+    };
+
+    // Loads the program as an IRX (it runs as the module's start function) and returns what happened.
+    Outcome load(IopSubsystem &iop, iop_test::Host &host)
+    {
+        iop_test::Irx image;
+        image.words(0u, {kWords[0], kWords[1], kWords[2], kWords[3], kWords[4], kWords[5], kWords[6]});
+        image.install(host);
+        const uint64_t before = iop.debugSnapshot().emulatorInstructions;
+        const ModuleLoadResult r = iop.loadModuleBuffer(0x1000u);
+        Outcome o;
+        o.start = r.startResult;
+        o.instructions = iop.debugSnapshot().emulatorInstructions - before;
+        o.stats = nativeModuleStats();
+        for (const std::string &line : host.logs)
+            if (line.find("[don-iop] native") != std::string::npos)
+                o.logged = true;
+        return o;
+    }
+
+    int failures = 0;
+    void expect(bool ok, const char *what)
+    {
+        if (!ok)
+        {
+            std::cerr << "FAIL: " << what << "\n";
+            ++failures;
+        }
+    }
+}
+
+int main()
+{
+    // Baseline: no module registered.
+    registerNativeModule(nullptr);
+    uint64_t baseline = 0;
+    {
+        iop_test::Host host;
+        IopSubsystem iop(host);
+        const Outcome o = load(iop, host);
+        expect(o.start == 4, "baseline start result");
+        expect(o.stats.calls == 0 && !o.stats.active, "no module: no native calls");
+        baseline = o.instructions;
+    }
+
+    const IopNativeModule good = module(runGood);
+    {
+        registerNativeModule(&good);
+        iop_test::Host host;
+        IopSubsystem iop(host);
+        const Outcome o = load(iop, host);
+        expect(o.start == 4, "native: same start result");
+        expect(o.instructions == baseline, "native: same instruction count as the interpreter");
+        expect(o.stats.active && !o.stats.disabled, "native: module active");
+        expect(o.stats.calls == 1 && o.stats.instructions == 4, "native: run() executed the 4 instructions once");
+        expect(o.logged, "native: activation is logged");
+
+        // Overwriting the code (the same program loaded again) disables the module for good.
+        const Outcome again = load(iop, host);
+        expect(again.start == 4 && again.instructions == baseline, "after a write: same result and count");
+        expect(again.stats.disabled && !again.stats.active, "a write into the code disables the module");
+        expect(again.stats.instructions == 4, "no native instruction after the write");
+    }
+    {
+        const IopNativeModule wrongHash = module(runGood, false);
+        registerNativeModule(&wrongHash);
+        iop_test::Host host;
+        IopSubsystem iop(host);
+        const Outcome o = load(iop, host);
+        expect(o.start == 4 && o.instructions == baseline, "wrong hash: interpreter result");
+        expect(o.stats.disabled && o.stats.calls == 0, "wrong hash: module disabled, never run");
+    }
+    {
+        registerNativeModule(&good);
+        setEnv("DON_IOP_NATIVE", "0");
+        iop_test::Host host;
+        IopSubsystem iop(host);
+        const Outcome o = load(iop, host);
+        expect(o.start == 4 && o.instructions == baseline, "DON_IOP_NATIVE=0: interpreter result");
+        expect(!o.stats.active && o.stats.calls == 0, "DON_IOP_NATIVE=0: module not used");
+        setEnv("DON_IOP_NATIVE", nullptr);
+    }
+    {
+        setEnv("DON_IOP_NATIVE_VERIFY", "1");
+        registerNativeModule(&good);
+        {
+            iop_test::Host host;
+            IopSubsystem iop(host);
+            const Outcome o = load(iop, host);
+            expect(o.start == 4 && o.instructions == baseline, "verify, correct module: result");
+            expect(o.stats.calls == 1 && o.stats.verifyDifferences == 0, "verify, correct module: no difference");
+        }
+        const IopNativeModule bad = module(runBad);
+        registerNativeModule(&bad);
+        {
+            iop_test::Host host;
+            IopSubsystem iop(host);
+            const Outcome o = load(iop, host);
+            expect(o.start == 4, "verify, wrong module: the interpreter's result is kept");
+            expect(o.stats.verifyDifferences == 1, "verify, wrong module: the difference is counted");
+            bool printed = false;
+            for (const std::string &line : host.logs)
+                if (line.find("[don-iop] native verify") != std::string::npos && line.find("DIFFERENCE") != std::string::npos)
+                    printed = true;
+            expect(printed, "verify, wrong module: the difference is reported");
+        }
+        setEnv("DON_IOP_NATIVE_VERIFY", nullptr);
+    }
+    registerNativeModule(nullptr);
+    if (failures == 0)
+        std::cout << "iop native module tests passed\n";
+    return failures == 0 ? 0 : 1;
+}
