+    uint32_t createTestThread(IopKernel &kernel, IopMemory &memory, uint32_t slot, uint32_t priority)
+    {
+        const uint32_t descriptor = 0x3000u + slot * 0x20u;
+        memory.write32(descriptor + 0u, 0u);
+        memory.write32(descriptor + 4u, 0u);
+        memory.write32(descriptor + 8u, 0x10000u + slot * 0x100u);
+        memory.write32(descriptor + 12u, 0x400u);
+        memory.write32(descriptor + 16u, priority);
+        IopCpuState cpu{};
+        cpu.gpr[4] = descriptor;
+        (void)kernel.dispatchThreadImport(4u, cpu, 0u);
+        return cpu.gpr[2];
+    }
+
+    void startTestThread(IopKernel &kernel, uint32_t id)
+    {
+        IopCpuState cpu{};
+        cpu.gpr[4] = id;
+        (void)kernel.dispatchThreadImport(6u, cpu, 0u);
+    }
+
+    // Ready order: FIFO among equal priorities, a preempted thread keeps its place, only a strictly higher priority preempts.
+    bool testReadyOrder()
+    {
+        IopMemory memory;
+        IopKernel kernel(memory);
+        kernel.reset();
+        const uint32_t a = createTestThread(kernel, memory, 0u, 39u); // lower id
+        const uint32_t b = createTestThread(kernel, memory, 1u, 39u);
+        const uint32_t h = createTestThread(kernel, memory, 2u, 10u);
+        constexpr uint32_t sentinel = 0xFFFFFFF0u;
+
+        startTestThread(kernel, a);
+        IopThread *t = kernel.beginNextReady(0u);
+        if (!expect(t && t->id == static_cast<int>(a), "a was not picked"))
+            return false;
+        IopCpuState cpu{};
+        kernel.delayCurrentUntil(100u, cpu);
+        kernel.endTimeslice(*t, sentinel);
+
+        startTestThread(kernel, b);
+        t = kernel.beginNextReady(50u);
+        if (!expect(t && t->id == static_cast<int>(b), "b was not picked"))
+            return false;
+        kernel.endTimeslice(*t, sentinel); // preempted at a slice end
+
+        // a's delay expires: b keeps the processor against the equal priority although a has the lower id
+        t = kernel.beginNextReady(200u);
+        if (!expect(t && t->id == static_cast<int>(b), "a woke and preempted b of equal priority"))
+            return false;
+        kernel.endTimeslice(*t, sentinel);
+
+        startTestThread(kernel, h);
+        t = kernel.beginNextReady(200u);
+        if (!expect(t && t->id == static_cast<int>(h), "a higher priority thread did not preempt"))
+            return false;
+        kernel.sleepCurrent(cpu);
+        kernel.endTimeslice(*t, sentinel);
+
+        t = kernel.beginNextReady(200u);
+        if (!expect(t && t->id == static_cast<int>(b), "the preempted thread did not resume before the later-woken one"))
+            return false;
+        kernel.endTimeslice(*t, sentinel);
+        t = kernel.beginNextReady(200u);
+        return expect(t && t->id == static_cast<int>(b), "the preempted thread lost the head of its queue");
+    }
