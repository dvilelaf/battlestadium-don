new file mode 100644
index 0000000..2d0e571
--- /dev/null
+++ b/ps2xRuntime/include/runtime/don_hot_state.h
@@ -0,0 +1,47 @@
+#pragma once
+
+// DonHotState: the fields the inline guest dispatch path (PS2Runtime::dispatchGuestBranch and
+// EeScheduler::checkpointDue/accountCycles, PS2Memory::advanceEeTimers) reads and writes on every guest
+// call, gathered in one standard-layout struct owned by PS2Runtime. EeScheduler and PS2Memory keep a
+// pointer to it. The layout is part of the game-module ABI (work/t605/abi/don_guest_abi.h): a generated
+// module accesses these fields directly, so do not reorder them.
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <type_traits>
+
+struct DonHotState
+{
+    // EeScheduler
+    uint64_t eeCycle = 0;
+    uint64_t nextFastPathCycle = 0;
+    uint64_t iopPendingEeCycles = 0;
+    uint64_t iopBatchEeCycles = 0;
+    uint64_t dispatchCount = 0;
+    uint64_t fastPathCount = 0;
+    uint32_t pendingEeTimerInterrupts = 0;
+    // PS2Memory (EE timer driver)
+    uint32_t timerIrqMask = 0;
+    uint64_t timerPendingCycles = 0;
+    uint64_t timerCyclesToEvent = std::numeric_limits<uint64_t>::max();
+    // Flags; checkpointPending and stopRequested are touched by other threads.
+    std::atomic<bool> checkpointPending{false};
+    bool unwinding = false;
+    std::atomic<bool> stopRequested{false};
+    bool historyEnabled = false;
+    // Dense table of the generated functions (g_ps2RecompiledFunctionTable*), filled by PS2Runtime.
+    uint32_t fnTableBase = 0;
+    uint32_t fnTableEnd = 0;
+    uint32_t fnTableSlots = 0;
+    uint32_t reserved0 = 0;
+    void (*const *fnTable)(uint8_t *, struct R5900Context *, class PS2Runtime *) = nullptr;
+};
+
+static_assert(std::is_standard_layout_v<DonHotState>, "DonHotState is part of the module ABI");
+static_assert(sizeof(std::atomic<bool>) == 1 && std::atomic<bool>::is_always_lock_free, "flags are one byte");
+static_assert(offsetof(DonHotState, eeCycle) == 0 && offsetof(DonHotState, pendingEeTimerInterrupts) == 48 &&
+                  offsetof(DonHotState, timerPendingCycles) == 56 && offsetof(DonHotState, checkpointPending) == 72 &&
+                  offsetof(DonHotState, fnTableBase) == 76 && offsetof(DonHotState, fnTable) == 96 &&
+                  sizeof(DonHotState) == 104,
+              "DonHotState layout");
