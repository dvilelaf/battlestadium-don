@@ -233,14 +240,17 @@ namespace ps2x::iop::detail
         case 18:
             setV0(0);
             return true;
-        case 19: // SetRpcQueue
+        case 19: // SetRpcQueue(queue, thread id)
+            m_queueThreads[cpu.gpr[4]] = static_cast<int>(cpu.gpr[5]);
             setV0(cpu.gpr[4]);
             return true;
         case 20:
         case 21:
             setV0(0);
             return true;
-        case 22: // RpcLoop
+        case 22: // RpcLoop(queue)
+            if (m_kernel.currentThreadId() != 0)
+                m_queueThreads.emplace(cpu.gpr[4], m_kernel.currentThreadId());
             m_kernel.sleepCurrent(cpu);
             setV0(0);
             return true;
@@ -292,6 +302,13 @@ namespace ps2x::iop::detail
             }
         }
 
+        // The console runs the handler in the server thread, which only gets the processor when every thread of higher
+        // priority is blocked. Run those first: the handler must not land in the middle of what they do.
+        const auto queueThread = m_queueThreads.find(server.queue);
+        uint32_t serverPriority = 0u;
+        if (queueThread != m_queueThreads.end() && m_kernel.threadPriority(queueThread->second, serverPriority))
+            executor.runThreadsUntilIdle(serverPriority, kServerWaitCycles);
+
         uint32_t returnPointer = executor.executeGuestFunction(server.function,
                                                                request.function,
                                                                server.buffer,
