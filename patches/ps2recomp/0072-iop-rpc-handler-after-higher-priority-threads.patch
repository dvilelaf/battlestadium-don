# 0072-iop-rpc-handler-after-higher-priority-threads: an RPC handler runs after the IOP threads that outrank its server thread
#
# What it fixes: the stall of fight_practice and survival_result after "E2004090216 : Specified handle is invalid"
# (journal 034 follow-ups 18, 21, 22). The port runs an RPC handler synchronously, between IOP slices, on a fresh CPU, whatever
# the IOP threads were doing. On the console the handler runs in the server thread (sceSifRpcLoop), which only gets the
# processor when every thread of higher priority is blocked. CRI_ADXI's server thread has priority 48 and its SPU2 transfer
# thread 39: request 0x409 (destroy a stream object) landed while the transfer thread was Ready in the middle of its walk over
# six stream objects (measured: IOP thread 10 Ready at pc 0x73E28, 0x409 handled, the next call on the destroyed object
# prints the error). Now handleRpc first runs the Ready threads whose priority number is at most the server thread's (at most
# 200,000 IOP cycles), then the handler. The server thread is the one that called sceSifRpcLoop (or the id given to
# sceSifSetRpcQueue) for the server's queue; a server with no known thread keeps the old behaviour.
# Verified: fight_practice and survival_result (slow routes, FFmpeg build) fail before and pass after; test
# tests/runtime/iop_rpc_server_priority_test.cpp fails without the change (handler saw the worker inside its run) and passes with it.
# Not the console's mechanism in detail: the handler still runs on a fresh CPU, not on the server thread's stack.
#
diff --git a/ps2xIOP/src/emulator/core/iop_kernel.cpp b/ps2xIOP/src/emulator/core/iop_kernel.cpp
index a4b5b74..35ad53c 100644
--- a/ps2xIOP/src/emulator/core/iop_kernel.cpp
+++ b/ps2xIOP/src/emulator/core/iop_kernel.cpp
@@ -670,7 +670,16 @@ namespace ps2x::iop::detail
         cpu.yielded = true;
     }
 
-    IopThread *IopKernel::beginNextReady(uint64_t currentCycle)
+    bool IopKernel::threadPriority(int id, uint32_t &priority) const
+    {
+        const auto it = m_threads.find(id);
+        if (it == m_threads.end() || it->second.state == IopThreadState::Dead)
+            return false;
+        priority = it->second.priority;
+        return true;
+    }
+
+    IopThread *IopKernel::beginNextReady(uint64_t currentCycle, uint32_t maxPriority)
     {
         for (auto &[id, thread] : m_threads)
         {
@@ -692,7 +701,7 @@ namespace ps2x::iop::detail
         {
             if (held_next != nullptr)
                 break;
-            if (thread.state != IopThreadState::Ready)
+            if (thread.state != IopThreadState::Ready || thread.priority > maxPriority)
                 continue;
             if (next == nullptr || thread.priority < next->priority ||
                 (thread.priority == next->priority && thread.id < next->id))
diff --git a/ps2xIOP/src/emulator/core/iop_kernel.h b/ps2xIOP/src/emulator/core/iop_kernel.h
index 9b9c269..ada514b 100644
--- a/ps2xIOP/src/emulator/core/iop_kernel.h
+++ b/ps2xIOP/src/emulator/core/iop_kernel.h
@@ -63,7 +63,10 @@ namespace ps2x::iop::detail
         void sleepCurrent(IopCpuState &cpu);
         void delayCurrentUntil(uint64_t wakeCycle, IopCpuState &cpu);
 
-        [[nodiscard]] IopThread *beginNextReady(uint64_t currentCycle);
+        // maxPriority: only threads whose priority number is at most this one are taken (0xFFFFFFFF = any).
+        [[nodiscard]] IopThread *beginNextReady(uint64_t currentCycle, uint32_t maxPriority = 0xFFFFFFFFu);
+        [[nodiscard]] int currentThreadId() const noexcept { return m_currentThread != nullptr ? m_currentThread->id : 0; }
+        [[nodiscard]] bool threadPriority(int id, uint32_t &priority) const;
         [[nodiscard]] uint64_t nextWakeCycle(uint64_t fallback) const;
         void endTimeslice(IopThread &thread, uint32_t returnSentinel);
         void cleanupDeadThreads();
diff --git a/ps2xIOP/src/emulator/iop_emulator.cpp b/ps2xIOP/src/emulator/iop_emulator.cpp
index ea9f4ed..9e0949b 100644
--- a/ps2xIOP/src/emulator/iop_emulator.cpp
+++ b/ps2xIOP/src/emulator/iop_emulator.cpp
@@ -523,6 +523,28 @@ namespace ps2x::iop::detail
             return cpu.gpr[2];
         }
 
+        void runThreadsUntilIdle(uint32_t maxPriority, uint64_t maxCycles) override
+        {
+            // Not from inside a thread's own slice or a handler: only the scheduler decides who runs.
+            if (activeCpu != nullptr || callDepth != 0u)
+                return;
+            const uint64_t limit = totalCycles + maxCycles;
+            while (totalCycles < limit)
+            {
+                syncHostSpu2();
+                servicePendingDmaInterrupts();
+                servicePendingGuestCallbacks();
+                IopThread *next = kernel.beginNextReady(totalCycles, maxPriority);
+                if (!next)
+                    break;
+                const uint64_t before = totalCycles;
+                runCpu(next->cpu, static_cast<uint32_t>(std::min<uint64_t>(kDefaultSlice, limit - totalCycles)));
+                kernel.endTimeslice(*next, kThreadReturnSentinel);
+                if (totalCycles == before)
+                    ++totalCycles;
+            }
+        }
+
         uint32_t executeGuestFunction(uint32_t address,
                                       uint32_t a0,
                                       uint32_t a1,
