+void EeScheduler::setTurbo(bool on)
+{
+    assertExecutor();
+    if (on == m_turbo)
+        return;
+    m_turbo = on;
+    if (on)
+        return;
+    // Back to real time: the deadlines taken while running ahead lie in the future by as much as the run gained;
+    // put each one at its emulated distance from now, so pacing resumes without a stall.
+    std::unique_lock lock(m_eventMutex);
+    const auto now = std::chrono::steady_clock::now();
+    for (ScheduledEvent &item : m_deadlines)
+    {
+        const uint64_t ahead = item.deadlineCycle > m_hot->eeCycle ? item.deadlineCycle - m_hot->eeCycle : 0u;
+        item.hostDeadline = now + eeCyclesToHostDuration(ahead);
+    }
+    updateNextDeadline();
+}
