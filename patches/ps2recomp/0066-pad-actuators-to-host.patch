# 0066-pad-actuators-to-host: the guest's vibration calls reach the host
#
# What it fixes: scePadSetActAlign and scePadSetActDirect answered 1 and did nothing, so the game's own vibration
# setting (key configuration, "Vibration ON/OFF" per player) never reached a gamepad. Now the runtime keeps the
# align table (which byte of the data drives the small motor, 0, or the large one, 1; 0xFF none) and the last data
# per (port, slot) as the SDK defines them, derives the two motors (small on/off, large 0..255) and tells the host
# through a new optional callback of Ps2HostPad, `actuator(user, port, slot, small, large)`, on the game thread and
# only when the pair changed. A closed port, scePadInit and scePadEnd switch the motors off (one callback with 0, 0);
# scePadPortOpen resets the align table to the default {0, 1, FF...}: the game never calls scePadSetActAlign (measured) and
# sends {small, large} to SetActDirect, so byte 0 is the small motor and byte 1 the large one. Both calls answer 0 for a pad that is not open, not plugged in
# or outside the description (they answered 1 always). DON_TRACE_PAD_ACT=1 prints one "[don-pad]" line per call
# (off by default, no cost when off; refused calls are traced too). A source without `actuator` behaves as before.
# Verified: tests/runtime/pad_actuator_test (the motors from the align table, change-only reports, two ports, close /
# init / end silence, refusals, no callback); tests/runtime/host_pad_source_test still passes; the game's calls in a
# fight: docs/journal/035-vibration.md.
#
diff --git a/ps2xRuntime/include/runtime/ps2_host_pad.h b/ps2xRuntime/include/runtime/ps2_host_pad.h
index 0c59217..08d4a5a 100644
--- a/ps2xRuntime/include/runtime/ps2_host_pad.h
+++ b/ps2xRuntime/include/runtime/ps2_host_pad.h
@@ -54,6 +54,13 @@ struct Ps2HostPad
     // Fills *out (initialised to "not connected, nothing pressed") for the pad at (port, slot). Called
     // only for a (port, slot) inside the description above. Required: a source without read is ignored.
     void (*read)(void *user, int port, int slot, Ps2HostPadState *out) = nullptr;
+
+    // Optional. The vibration motors of the pad at (port, slot) as the guest has set them with
+    // scePadSetActAlign/scePadSetActDirect: `small_motor` is 0 or 1 (the small motor is on or off) and
+    // `large_motor` 0..255 (the large motor's strength). Called on the game thread, only when the pair
+    // for that (port, slot) changed, and with 0, 0 when the guest closes the port or re-initialises the
+    // library. The same rules as read: copy the values and return, do not block or call into the runtime.
+    void (*actuator)(void *user, int port, int slot, uint8_t small_motor, uint8_t large_motor) = nullptr;
 };
 
 #endif
