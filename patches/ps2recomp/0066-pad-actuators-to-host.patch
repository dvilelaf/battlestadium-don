+        // The motors a pad's align table and last data give: the last byte of each motor wins.
+        void padMotorsFromData(const PadPortState &p, uint8_t &small, uint8_t &large)
+        {
+            small = 0u;
+            large = 0u;
+            for (int i = 0; i < 6; ++i)
+            {
+                if (p.actAlign[i] == 0u)
+                    small = p.actData[i] ? 1u : 0u;
+                else if (p.actAlign[i] == 1u)
+                    large = p.actData[i];
+            }
+        }
+
+        // Tells the host when the motors of (port, slot) changed. Called with g_padStateMutex held: the host's
+        // callback must not block (ps2_host_pad.h).
+        void padNotifyActuatorsLocked(PS2Runtime *runtime, int port, int slot, PadPortState &p)
+        {
+            uint8_t small = 0u, large = 0u;
+            padMotorsFromData(p, small, large);
+            if (small == p.actSmall && large == p.actLarge)
+                return;
+            p.actSmall = small;
+            p.actLarge = large;
+            if (padActTrace())
+                std::fprintf(stderr, "[don-pad] actuators port %d slot %d: small %u large %u\n", port, slot,
+                             static_cast<unsigned>(small), static_cast<unsigned>(large));
+            const Ps2HostPad *source = runtime ? runtime->padBackend().hostSource() : nullptr;
+            if (source && source->actuator)
+                source->actuator(source->user, port, slot, small, large);
+        }
+
+        // The motors go off: a closed port or a re-initialised library does not leave a pad shaking.
+        void padSilenceAllLocked(PS2Runtime *runtime)
+        {
+            for (size_t port = 0; port < kPadPortCount; ++port)
+            {
+                for (size_t slot = 0; slot < kPadMaxSlotCount; ++slot)
+                {
+                    PadPortState &p = g_padPorts[port][slot];
+                    std::memset(p.actData, 0, sizeof(p.actData));
+                    padNotifyActuatorsLocked(runtime, static_cast<int>(port), static_cast<int>(slot), p);
+                }
+            }
+        }
+
