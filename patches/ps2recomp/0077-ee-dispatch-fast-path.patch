+// Patch 0077: the common path of every guest dispatch, inlined into its callers (the run loop, the
+// branch dispatcher and the checkpoint the generated code calls). The statements and their order
+// are those of the former out-of-line versions.
+inline void EeScheduler::accountCycles(uint32_t cycles) noexcept
+{
+    const uint64_t elapsed = cycles > 1u ? cycles : 1u;
+    m_eeCycle += elapsed;
+    m_pendingEeTimerInterrupts |= m_runtime.memory().advanceEeTimers(elapsed);
+    m_iopPendingEeCycles += elapsed;
+    if (m_iopPendingEeCycles >= m_iopBatchEeCycles)
+    {
+        flushIopDebt();
+    }
+    if (m_pendingEeTimerInterrupts != 0u)
+    {
+        m_checkpointPending.store(true, std::memory_order_release);
+    }
+}
+
+inline bool EeScheduler::checkpointDue(uint32_t cycles) noexcept
+{
+    accountCycles(cycles);
+    ++m_dispatchCount;
+    if (!m_checkpointPending.load(std::memory_order_relaxed) && m_eeCycle < m_nextFastPathCycle)
+    {
+        ++m_fastPathCount;
+        return false;
+    }
+    return checkpointDueSlow();
+}
