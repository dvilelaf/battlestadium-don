+void PS2Runtime::iopThreadMain()
+{
+    g_ps2OnIopThread = true;
+    std::unique_lock lock(m_iopMutex);
+    for (;;)
+    {
+        m_iopCv.wait(lock, [this]
+                     { return m_iopJobPending || m_iopThreadStop; });
+        if (!m_iopJobPending)
+            break;
+        const uint64_t cycles = m_iopJobCycles;
+        lock.unlock();
+        m_iopSubsystem->runEeCycles(cycles);
+        lock.lock();
+        m_iopJobPending = false;
+        m_iopCv.notify_all();
+    }
+}
+
+void PS2Runtime::waitIopIdle()
+{
+    if (!m_iopThread.joinable())
+        return;
+    std::unique_lock lock(m_iopMutex);
+    m_iopCv.wait(lock, [this]
+                 { return !m_iopJobPending; });
+}
+
+void PS2Runtime::stopIopThread()
+{
+    if (!m_iopThread.joinable())
+        return;
+    {
+        std::lock_guard lock(m_iopMutex);
+        m_iopThreadStop = true;
+    }
+    m_iopCv.notify_all();
+    m_iopThread.join();
+}
