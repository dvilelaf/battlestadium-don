+// Patch 0077: the per-dispatch part of the EE timer driver is defined here so that the scheduler's
+// fast path (called for every guest dispatch) inlines it; the arithmetic stays in applyEeTimers().
+inline uint32_t PS2Memory::advanceEeTimers(uint64_t eeCycles) noexcept
+{
+    creditEeTimers(eeCycles);
+    const uint32_t pending = m_pendingEeTimerInterruptMask;
+    m_pendingEeTimerInterruptMask = 0u;
+    return pending;
+}
+
+inline void PS2Memory::creditEeTimers(uint64_t eeCycles) noexcept
+{
+    if (eeCycles == 0u)
+    {
+        return;
+    }
+    // The cycles of this dispatch belong to the timers too: queue them before deciding whether the
+    // boundary was reached.
+    m_eeTimerPendingCycles += eeCycles;
+    if (m_eeTimerCyclesToEvent > eeCycles)
+    {
+        m_eeTimerCyclesToEvent -= eeCycles;
+        return;
+    }
+    m_eeTimerCyclesToEvent = 0u;
+    m_pendingEeTimerInterruptMask |= applyEeTimers();
+}
