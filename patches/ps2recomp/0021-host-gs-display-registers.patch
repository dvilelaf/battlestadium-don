+    // ---- Host-GS mode --------------------------------------------------------------------------------
+    // With a host GS installed (PS2Runtime::setHostGs) the display registers reach a real GS, so the
+    // sceGs* handlers have to produce what the game's own SDK code produces. Without one, the runtime's
+    // own GS keeps the values it was written for and nothing below is used.
+
+    static bool gsHostMode(PS2Runtime *runtime)
+    {
+        return runtime && runtime->hostGs() != nullptr;
+    }
+
+    // The display environment sceGsSetDefDispEnv builds (PMODE, SMODE2, DISPFB, DISPLAY) from the SDK
+    // formulas: NTSC (omode 2) and PAL (omode 3) only. Any other output mode reads screen offsets from a
+    // file and a syscall in the SDK; there it returns false and the caller keeps the legacy values.
+    struct GsSdkDispEnv
+    {
+        uint64_t pmode;
+        uint64_t smode2;
+        uint64_t dispfb;
+        uint64_t display;
+    };
+
+    static bool makeGsSdkDispEnv(const GsGParam &gp, uint32_t psm, int32_t w, int32_t h, int32_t dx, int32_t dy,
+                                 GsSdkDispEnv &out)
+    {
+        if ((gp.omode != 2u && gp.omode != 3u) || w <= 0)
+            return false;
+        const bool interlace = gp.interlace != 0u;
+        const bool field = gp.ffmode != 0u;
+        out.pmode = 0x66u;
+        out.smode2 = interlace ? (field ? 3u : 1u) : 2u;
+        out.dispfb = (static_cast<uint64_t>(psm & 0xFu) << 15) |
+                     (static_cast<uint64_t>(static_cast<uint32_t>(w + 63) >> 6 & 0x3Fu) << 9);
+        const int32_t x0 = gp.omode == 2u ? 0x27C : 0x290;
+        int32_t dyBase;
+        if (gp.omode == 2u)
+            dyBase = interlace ? 0x32 : 0x19;
+        else
+            dyBase = interlace ? 0x48 : 0x24;
+        const int32_t dh = (interlace && field) ? h * 2 - 1 : h - 1;
+        const int32_t magh = (w + 0x9FF) / w;
+        out.display = (static_cast<uint64_t>(magh - 1) << 23) |
+                      (static_cast<uint64_t>(magh * w - 1) << 32) |
+                      (static_cast<uint64_t>(dx * magh + x0) & 0xFFFu) |
+                      (static_cast<uint64_t>(dh) << 44) |
+                      ((static_cast<uint64_t>(dy + dyBase) & 0xFFFu) << 12);
+        return true;
+    }
+
+    // One line per output mode that has no SDK formula here (host-GS mode keeps the legacy values for it).
+    static void warnGsHostOutputMode(const char *what, uint32_t omode)
+    {
+        static std::atomic<uint32_t> seen{0u};
+        if (omode < 32u && (seen.fetch_or(1u << omode) & (1u << omode)) != 0u)
+            return;
+        RUNTIME_ERROR("[ps2x] " << what << ": output mode 0x" << std::hex << omode << std::dec
+                                << " has no SDK display formula in host-GS mode; keeping the legacy values\n");
+    }
+
+    // The page count the game's own sceGszbufaddr (guest 0x100A40) returns: the page count of the frame,
+    // halved for an interlaced field display (docs/knowledge/18-display-registers.md section 2).
+    static uint32_t gsSdkZbufPages(uint32_t psm, int32_t w, int32_t h, bool interlaceField)
+    {
+        int32_t widthBlocks = (w + 63) >> 6;
+        if (w + 63 < 0)
+            widthBlocks = (w + 126) >> 6;
+
+        int32_t heightBlocks;
+        if ((psm & 2u) != 0u)
+        {
+            heightBlocks = (h + 63) >> 6;
+            if (h + 63 < 0)
+                heightBlocks = (h + 126) >> 6;
+        }
+        else
+        {
+            heightBlocks = (h + 31) >> 5;
+            if (h + 31 < 0)
+                heightBlocks = (h + 62) >> 5;
+        }
+
+        const int32_t pages = widthBlocks * heightBlocks;
+        return static_cast<uint32_t>(interlaceField ? pages : pages * 2);
+    }
+
+    // The display half of the double buffer sceGsSetDefDBuff/sceGsSetDefDBuffDc build: the display
+    // environment both buffers share, the page count of the z-buffer and DTHE. Both buffers get their own
+    // frame-buffer page only for a progressive or an interlaced field display, at half the z-buffer page.
+    struct GsSdkDBuff
+    {
+        GsSdkDispEnv disp[2];
+        uint32_t zbufPages = 0;
+        uint32_t fbp1 = 0; // frame-buffer page of the second buffer
+        bool dthe = false;
+    };
+
+    static bool makeGsSdkDBuff(const GsGParam &gp, uint32_t psm, int32_t w, int32_t h, GsSdkDBuff &out)
+    {
+        if (!makeGsSdkDispEnv(gp, psm, w, h, 0, 0, out.disp[0]))
+            return false;
+        out.disp[1] = out.disp[0];
+        out.zbufPages = gsSdkZbufPages(psm, w, h, gp.interlace != 0u && gp.ffmode != 0u);
+        out.dthe = (psm & 2u) != 0u;
+        if (gp.interlace == 0u || gp.ffmode != 0u)
+            out.fbp1 = (out.zbufPages >> 1) & 0x1FFu;
+        out.disp[1].dispfb = (out.disp[1].dispfb & ~0x1FFull) | out.fbp1;
+        return true;
+    }
+
     static void applyGsDispEnv(PS2Runtime *runtime, const GsDispEnvMem &env)
     {
         if (!runtime || !runtime->syncCoreSubsystems())
             return;
         auto &regs = runtime->memory().gs();
+        if (gsHostMode(runtime))
+        {
+            // sceGsPutDispEnv: GS revision 1 drives circuit 1, every later one circuit 2 only.
+            regs.pmode = env.pmode;
+            if (g_gparam.version == 1u)
+            {
+                regs.dispfb1 = env.dispfb;
+                regs.display1 = env.display;
+                regs.extdata = env.bgcolor; // the same slot: sceGsPutDispEnv writes it to EXTDATA
+            }
+            else
+            {
+                regs.smode2 = env.smode2;
+                regs.dispfb2 = env.dispfb;
+                regs.display2 = env.display;
+                regs.bgcolor = env.bgcolor;
+            }
+            return;
+        }
         regs.pmode = env.pmode;
         regs.smode2 = env.smode2;
         regs.dispfb1 = env.dispfb;
