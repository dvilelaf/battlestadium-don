 namespace ps2_syscalls
 {
+    namespace
+    {
+        // The video registers the BIOS SetGsCrt writes, for the one mode whose values were measured: NTSC
+        // (video mode 2), interlaced, from docs/knowledge/18-display-registers.md section 1. Returns false
+        // without a host GS and for every other mode, so that the caller keeps the legacy registers.
+        // SMODE2 follows the SDK's rule (interlace ? (ffmode ? 3 : 1) : 2); PMODE is not written here,
+        // sceGsPutDispEnv writes it. The values reach the host GS in the privileged-register array of
+        // Ps2HostGs::vsync (PS2Runtime::notifyHostGsVsync).
+        bool setHostGsVideoRegisters(PS2Runtime *runtime, int interlaced, int videoMode, int frameMode)
+        {
+            if (!runtime || runtime->hostGs() == nullptr)
+                return false;
+            if ((interlaced & 0x1) != 1 || videoMode != 2)
+            {
+                // One line per distinct mode; everything else keeps the legacy behaviour.
+                static std::atomic<uint32_t> warned{0u};
+                const uint32_t bit = 1u << ((interlaced & 1) | ((videoMode & 0xF) << 1));
+                if ((warned.fetch_or(bit) & bit) == 0u)
+                    RUNTIME_ERROR("[ps2x] GsSetCrt: only NTSC interlace (interlaced=1, video mode 2) has measured "
+                                  "video registers with a host GS; interlaced="
+                                  << interlaced << " video mode=0x" << std::hex << videoMode << std::dec
+                                  << " ffmode=" << frameMode << "; keeping the legacy registers\n");
+                return false;
+            }
+
+            auto &gs = runtime->memory().gs();
+            gs.smode1 = 0x740814504ull;
+            gs.smode2 = (frameMode != 0) ? 3ull : 1ull;
+            gs.srfsh = 0x8ull;
+            gs.synch1 = 0x7F5B61F06F040ull;
+            gs.synch2 = 0x33A4D8ull;
+            gs.syncv = 0xC7800601A01801ull;
+            return true;
+        }
+    }
+
