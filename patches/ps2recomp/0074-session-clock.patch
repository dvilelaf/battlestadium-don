 #include <cstdint>
+#include <ctime>
 #include <vector>
 #include <string>
 #include <string_view>
@@ -302,6 +303,15 @@ public:
     void setHostPad(const Ps2HostPad *host);
     inline bool hostOwnsWindow() const { return m_hostOwnsWindow; }
 
+    // Session clock (patch 0074, docs/knowledge/22-netplay.md section 8): once set, every host time the
+    // guest can see comes from epoch_seconds + vsync_tick / 60 (UTC), never from the PC. Unset, nothing
+    // changes. Call while the game thread is not running.
+    void setSessionClock(uint64_t epoch_seconds);
+    bool hasSessionClock() const;
+    uint64_t sessionEpoch() const;
+    // The session time at the current vertical blank: epoch + vsync_tick / 60, as a UTC time_t. 0 when unset.
+    std::time_t sessionTimeNow() const;
+
     bool initialize(const char *title = "PS2 Game");
     bool syncCoreSubsystems();
     bool loadELF(const std::string &elfPath);
@@ -555,6 +565,8 @@ private:
     Ps2HostGs m_hostGsStorage;
     bool m_hostGs = false;
     bool m_hostOwnsWindow = false;
+    uint64_t m_sessionEpoch = 0;
+    bool m_sessionClockSet = false;
     std::thread m_gameThread;
     std::atomic<bool> m_gameThreadFinished{true};
     std::atomic<bool> m_gameThreadFailed{false};
diff --git a/ps2xRuntime/src/lib/ps2_runtime.cpp b/ps2xRuntime/src/lib/ps2_runtime.cpp
index cd0303c..7202f03 100644
--- a/ps2xRuntime/src/lib/ps2_runtime.cpp
+++ b/ps2xRuntime/src/lib/ps2_runtime.cpp
@@ -511,6 +511,39 @@ PS2Runtime::PS2Runtime()
     m_asyncCallbackStackTop = kInvocationStackBase;
     m_kernelHeapBase = 0x00100000u;
     m_kernelHeapEnd = PS2_RAM_SIZE;
+
+    // DON_SESSION_EPOCH=<seconds> sets the session clock without netplay (patch 0074), so that the
+    // determinism checks can compare two runs with different host clocks or time zones.
+    if (const char *epoch = std::getenv("DON_SESSION_EPOCH"); epoch != nullptr && epoch[0] != '\0')
+    {
+        setSessionClock(std::strtoull(epoch, nullptr, 0));
+    }
+}
+
+void PS2Runtime::setSessionClock(uint64_t epoch_seconds)
+{
+    m_sessionEpoch = epoch_seconds;
+    m_sessionClockSet = true;
+}
+
+bool PS2Runtime::hasSessionClock() const
+{
+    return m_sessionClockSet;
+}
+
+uint64_t PS2Runtime::sessionEpoch() const
+{
+    return m_sessionEpoch;
+}
+
+std::time_t PS2Runtime::sessionTimeNow() const
+{
+    if (!m_sessionClockSet)
+    {
+        return 0;
+    }
+    const uint64_t tick = m_eeScheduler != nullptr ? m_eeScheduler->currentVSyncTick() : 0u;
+    return static_cast<std::time_t>(m_sessionEpoch + tick / 60u);
 }
 
