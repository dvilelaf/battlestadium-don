# Generates a C++ source file that embeds the start screen's Nunito TTFs as byte arrays
# (T-523). Pure CMake, so the container build needs no external tool (no xxd, no Python).
#
#   cmake -DSRC_DIR=<src/host/ui/fonts> -DOUT_CPP=<path/fonts_embedded.cpp> -P embed_fonts.cmake
#
# The bytes are read as hex and each pair is rewritten as "0xNN," with one regex (fast for a
# ~130 KB font). The symbols are declared by src/host/ui/fonts/fonts_embedded.h.
file(READ "${SRC_DIR}/Nunito-ExtraBold.ttf" _eb HEX)
file(READ "${SRC_DIR}/Nunito-Regular.ttf" _rg HEX)
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _eb "${_eb}")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _rg "${_rg}")
file(WRITE "${OUT_CPP}"
"// Generated by src/host/ui/fonts/embed_fonts.cmake from the TTFs in src/host/ui/fonts/. Do not edit.\n"
"#include \"fonts/fonts_embedded.h\"\n"
"namespace don_host::ui::fonts {\n"
"const unsigned char kExtraBold[] = { ${_eb} };\n"
"const unsigned int kExtraBoldSize = sizeof(kExtraBold);\n"
"const unsigned char kRegular[] = { ${_rg} };\n"
"const unsigned int kRegularSize = sizeof(kRegular);\n"
"} // namespace don_host::ui::fonts\n")
