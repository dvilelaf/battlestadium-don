# Paths that belong to this machine. Copy this file to local.env (which git ignores) and fill
# in the values. Scripts that need them read local.env by themselves; in a terminal, load it
# with:   set -a; . ./local.env; set +a
#
# A variable that is already set in the environment is left as it is (that is what the
# "${NAME=value}" form does), so a value given on the command line wins.

# The disc image of Battle Stadium D.O.N (Japan), SLPS-25675. Check it with
# tools/disc/verify_disc.py.
: "${DON_ISO=/path/to/Battle Stadium D.O.N.iso}"

# Folder that holds a PS2 BIOS dumped from your own console. Only the reference emulator
# (tools/ref/run_pcsx2.sh) uses it; the port needs no BIOS.
: "${DON_PS2_BIOS_DIR=/path/to/ps2/bios}"

export DON_ISO DON_PS2_BIOS_DIR
